      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Tracks</string>
          <string name="Source"><![CDATA[--!strict
-- Реестр трасс: данные (TrackData) и готовые объекты Track, по одному на трассу.
local Track = require(script.Parent.Track)
local folder = script.Parent.TrackData

local Tracks = {}
Tracks.data = {
	sakura = require(folder.Sakura),
	neon = require(folder.Neon),
	sunset = require(folder.Sunset),
	momiji = require(folder.Momiji),
}

local cache = {}
function Tracks.get(id: string)
	local t = cache[id]
	if not t then
		local d = Tracks.data[id]
		assert(d, "нет трассы " .. tostring(id))
		t = Track.new(d)
		cache[id] = t
	end
	return t
end

return Tracks
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">ErrorRelay</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Диагностика: ошибки и предупреждения сервера складываются в ReplicatedStorage.SakuraServerLog,
-- чтобы клиентский экран загрузки (Boot) мог показать их игроку. Ни от чего не зависит.
local LogService = game:GetService("LogService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local log = Instance.new("StringValue")
log.Name = "SakuraServerLog"
log.Parent = ReplicatedStorage

local lines: { string } = {}
LogService.MessageOut:Connect(function(msg: string, kind: Enum.MessageType)
	if kind == Enum.MessageType.MessageError or kind == Enum.MessageType.MessageWarning then
		table.insert(lines, string.sub(msg, 1, 300))
		if #lines > 10 then
			table.remove(lines, 1)
		end
		log.Value = table.concat(lines, "\n")
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Сервер «Sakura Drift»: Гран-при из четырёх трасс по кругу, боты добивают сетку до 8 картов.
-- Свой карт каждый игрок считает у себя (физика из Shared/Kart) и шлёт состояние ~20 раз в секунду;
-- сервер ведёт ботов, кристаллы, предметы, монеты, круги, места, очки и награды.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Tracks = require(Shared.Tracks)
local Kart = require(Shared.Kart)
local Bot = require(Shared.Bot)
local Layout = require(Shared.Layout)
local Net = require(Shared.Net)
local Characters = require(Shared.Characters)
local Profiles = require(script.Parent.Profiles)

Players.CharacterAutoLoads = false -- в гонке аватар не нужен: камера и карт — свои

local RE_State = Net.get("KartState") :: UnreliableRemoteEvent
local RE_Snap = Net.get("Snapshot") :: UnreliableRemoteEvent
local RE_Race = Net.get("Race") :: RemoteEvent
local RE_Action = Net.get("Action") :: RemoteEvent
local RF_Shop = Net.get("Shop") :: RemoteFunction

local CHAR_BY_ID = {}
for _, c in Characters do
	CHAR_BY_ID[c.id] = c
end

local rng = Random.new()
local function rnd(): number
	return rng:NextNumber()
end
local function now(): number
	return workspace:GetServerTimeNow()
end

-- ---------------------------------------------------------------- состояние

type Racer = {
	id: number,
	key: string, -- для очков Гран-при: "p<UserId>" / "b<charId>"
	name: string,
	charId: string,
	isBot: boolean,
	player: Player?,
	body: any, -- Kart (бот) или прокси игрока с теми же полями
	bot: any?,
	finished: boolean,
	finishTime: number?,
	coinsTotal: number,
	hitCd: number,
	lastPacket: number,
}

local S = {
	phase = "lobby",
	phaseStart = now(),
	trackId = Config.TRACK_ORDER[1],
	track = nil :: any,
	raceNum = 0,
	gp = { points = {} :: { [string]: number }, names = {} :: { [string]: string }, botChars = {} :: { string } },
	racers = {} :: { Racer },
	byPlayer = {} :: { [Player]: Racer },
	order = {} :: { Racer },
	boxes = {} :: { any },
	coins = {} :: { any },
	orbs = {} :: { any },
	traps = {} :: { any },
	nextObjId = 1,
	raceStart = 0,
	firstHumanFinish = nil :: number?,
	allHumansDoneAt = nil :: number?,
	finishedCount = 0,
	lastResults = nil :: any,
	ready = {} :: { [Player]: boolean },
}

local diff = Bot.DIFFICULTY[Config.BOT_DIFFICULTY] or Bot.DIFFICULTY.normal

local function setPhase(phase: string)
	S.phase = phase
	S.phaseStart = now()
	ReplicatedStorage:SetAttribute("SD_Phase", phase)
	ReplicatedStorage:SetAttribute("SD_PhaseStart", S.phaseStart)
	ReplicatedStorage:SetAttribute("SD_Track", S.trackId)
	ReplicatedStorage:SetAttribute("SD_RaceNum", S.raceNum)
	ReplicatedStorage:SetAttribute("SD_RaceCount", #Config.TRACK_ORDER)
end

local function sendAll(kind: string, data: any?)
	for p in S.ready do
		RE_Race:FireClient(p, kind, data)
	end
end

local function send(p: Player?, kind: string, data: any?)
	if p and S.ready[p] then
		RE_Race:FireClient(p, kind, data)
	end
end

local function humans(): { Racer }
	local out = {}
	for _, r in S.racers do
		if not r.isBot then
			table.insert(out, r)
		end
	end
	return out
end

-- ---------------------------------------------------------------- подготовка гонки

local function newProxy(track)
	return {
		track = track,
		pos = Vector3.zero,
		heading = 0,
		moveHeading = 0,
		speed = 0,
		progress = 0,
		lateral = 0,
		lapsDone = -1,
		totalProgress = 0,
		airborne = false,
		finished = false,
		shieldTimer = 0,
		item = nil,
		roulette = 0,
		pendingItem = nil,
		itemHeld = 0,
		net = nil,
		isProxy = true,
	}
end

local function gridPlace(track, slot: number): (number, number)
	local L = track.length
	local row = math.floor(slot / 2)
	local col = slot % 2
	local fr0 = track:frameAtProgress(L - 8)
	local lat = (if col == 0 then -1 else 1) * fr0.hw * 0.42
	return L - 8 - row * 6.5 - col * 3, lat
end

local function shuffle<T>(t: { T })
	for i = #t, 2, -1 do
		local j = rng:NextInteger(1, i)
		t[i], t[j] = t[j], t[i]
	end
end

local function rosterView()
	local list = {}
	for _, r in S.racers do
		table.insert(list, {
			id = r.id,
			name = r.name,
			charId = r.charId,
			isBot = r.isBot,
			userId = if r.player then r.player.UserId else 0,
		})
	end
	return list
end

local function boxState()
	local out = {}
	for i, b in S.boxes do
		if not b.active then
			table.insert(out, { i, b.timer })
		end
	end
	return out
end

local function coinState()
	local out = {}
	for i, c in S.coins do
		if c.t > 0 then
			table.insert(out, { i, c.t })
		end
	end
	return out
end

local function trapList()
	local out = {}
	for _, t in S.traps do
		table.insert(out, { id = t.id, s = t.s, lat = t.lat, x = t.pos.X, y = t.pos.Y, z = t.pos.Z })
	end
	return out
end

local function setupView(forPlayer: Player?)
	local me = if forPlayer then S.byPlayer[forPlayer] else nil
	return {
		trackId = S.trackId,
		laps = Config.LAPS,
		raceNum = S.raceNum,
		raceCount = #Config.TRACK_ORDER,
		roster = rosterView(),
		myId = if me then me.id else 0,
		boxes = boxState(),
		coins = coinState(),
		traps = trapList(),
		phase = S.phase,
		phaseStart = S.phaseStart,
		raceStart = S.raceStart,
	}
end

local function startRace()
	S.raceNum += 1
	S.trackId = Config.TRACK_ORDER[((S.raceNum - 1) % #Config.TRACK_ORDER) + 1]
	local track = Tracks.get(S.trackId)
	S.track = track
	S.racers = {}
	S.byPlayer = {}
	S.orbs = {}
	S.traps = {}
	S.finishedCount = 0
	S.firstHumanFinish = nil
	S.allHumansDoneAt = nil

	-- кто едет: все готовые игроки (до 8), остальное — боты
	local plist = {}
	for p in S.ready do
		if p.Parent and Profiles.get(p) and #plist < Config.MAX_KARTS then
			table.insert(plist, p)
		end
	end
	local n = Config.MAX_KARTS
	local nb = n - #plist

	-- сетка: в первой гонке игроки — с середины, дальше — в обратном порядке очков (лидер стартует последним)
	local entries = {}
	for _, p in plist do
		local prof = Profiles.get(p)
		local cid = if CHAR_BY_ID[prof.selected] and prof.owned[prof.selected] then prof.selected else "sakura"
		table.insert(entries, { player = p, key = "p" .. p.UserId, name = p.DisplayName, charId = cid })
	end
	for i = 1, nb do
		local cid = S.gp.botChars[((i - 1) % #S.gp.botChars) + 1]
		table.insert(entries, { key = "b" .. cid .. i, name = CHAR_BY_ID[cid].name, charId = cid })
	end
	if S.raceNum % #Config.TRACK_ORDER == 1 then
		-- боты спереди и сзади, игроки — в середине
		local bots, ppl = {}, {}
		for _, e in entries do
			table.insert(if e.player then ppl else bots, e)
		end
		shuffle(bots)
		shuffle(ppl)
		local front = math.floor(#bots / 2)
		entries = {}
		for i = 1, front do
			table.insert(entries, bots[i])
		end
		for _, e in ppl do
			table.insert(entries, e)
		end
		for i = front + 1, #bots do
			table.insert(entries, bots[i])
		end
	else
		table.sort(entries, function(a, b)
			local pa, pb = S.gp.points[a.key] or 0, S.gp.points[b.key] or 0
			if pa ~= pb then
				return pa < pb
			end
			return a.key < b.key
		end)
	end

	for slot, e in entries do
		local s0, lat = gridPlace(track, slot - 1)
		local c = CHAR_BY_ID[e.charId]
		local r: Racer = {
			id = slot,
			key = e.key,
			name = e.name,
			charId = e.charId,
			isBot = e.player == nil,
			player = e.player,
			body = nil,
			bot = nil,
			finished = false,
			finishTime = nil,
			coinsTotal = 0,
			hitCd = 0,
			lastPacket = 0,
		}
		if r.isBot then
			local k = Kart.new(track, { stats = c.stats })
			k:placeAt(s0, lat)
			k.lapsDone = -1
			k.totalProgress = -track.length + k.progress
			k.botSpeed = diff.speed * (0.985 + rnd() * 0.03)
			k.item = nil
			k.roulette = 0
			k.itemHeld = 0
			k.onGrid = true
			r.body = k
			r.bot = Bot.new(k, diff, rnd)
		else
			local px = newProxy(track)
			local fr = track:frameAtProgress(s0)
			px.pos = fr.pos + fr.right * lat
			px.heading = math.atan2(fr.tan.X, fr.tan.Z)
			px.moveHeading = px.heading
			px.progress = s0
			px.lateral = lat
			px.totalProgress = -track.length + s0
			r.body = px
			S.byPlayer[e.player] = r
		end
		S.gp.names[r.key] = r.name
		table.insert(S.racers, r)
	end
	S.order = table.clone(S.racers)

	S.boxes = {}
	for _, b in Layout.boxes(track) do
		table.insert(S.boxes, { s = b.s, lat = b.lat, pos = b.pos, active = true, timer = 0 })
	end
	S.coins = {}
	for _, c in Layout.coins(track) do
		table.insert(S.coins, { s = c.s, lat = c.lat, pos = c.pos, t = 0 })
	end

	setPhase("intro")
	for p in S.ready do
		RE_Race:FireClient(p, "setup", setupView(p))
	end
end

local function newGP()
	S.raceNum = 0
	S.gp = { points = {}, names = {}, botChars = {} }
	local ids = {}
	for _, c in Characters do
		table.insert(ids, c.id)
	end
	shuffle(ids)
	S.gp.botChars = ids
	S.lastResults = nil
end

-- ---------------------------------------------------------------- предметы

local function placeFrac(r: Racer): number
	local idx = table.find(S.order, r) or 1
	return (idx - 1) / math.max(1, #S.order - 1)
end

local function racerOfBody(body): Racer?
	for _, r in S.racers do
		if r.body == body then
			return r
		end
	end
	return nil
end

local function giveBox(r: Racer)
	local b = r.body
	if b.item == nil and (b.roulette or 0) <= 0 then
		b.roulette = if r.isBot then 0.9 + rnd() * 0.5 else 1.35
		b.pendingItem = Layout.rollItem(placeFrac(r), rnd)
		send(r.player, "roulette", { item = b.pendingItem, time = b.roulette })
	end
end

local function hitRacer(r: Racer, kind: string, by: Racer?)
	if r.finished then
		return
	end
	local b = r.body
	if r.isBot then
		b:hit(kind)
	else
		if r.hitCd > 0 then
			return
		end
		r.hitCd = if kind == "freeze" then 2.6 else 2.2
		if b.shieldTimer > 0 then
			b.shieldTimer = 0
			r.hitCd = 0.6
		end
		send(r.player, "hit", { kind = kind, by = if by then by.id else 0 })
	end
	sendAll("hitFx", { id = r.id, kind = kind, by = if by then by.id else 0 })
end

local function fireOrb(r: Racer)
	local b = r.body
	local idx = table.find(S.order, r) or 1
	local target = if idx > 1 then S.order[idx - 1] else nil
	local pos = b.pos + Vector3.new(math.sin(b.heading) * 2.2, 0.9, math.cos(b.heading) * 2.2)
	local id = S.nextObjId
	S.nextObjId += 1
	table.insert(S.orbs, {
		id = id,
		owner = r,
		target = target,
		body = target and target.body,
		s = b.progress + 2.2,
		lat = b.lateral,
		pos = pos,
		speed = math.max(62, b.speed + 22),
		life = 7,
		age = 0,
		idx = S.track:project(pos, -1).nearest,
	})
	sendAll("orbFire", { id = r.id })
end

local function dropTrap(r: Racer)
	local b = r.body
	local tr = S.track
	local s = b.progress - 3.2
	local fr = tr:frameAtProgress(s)
	local lat = math.clamp(b.lateral, -fr.hw - 1, fr.hw + 1)
	local pos = fr.pos + fr.right * lat
	local id = S.nextObjId
	S.nextObjId += 1
	local t = { id = id, owner = r, s = s, lat = lat, pos = pos, age = 0 }
	table.insert(S.traps, t)
	sendAll("trapAdd", { id = id, s = s, lat = lat, x = pos.X, y = pos.Y, z = pos.Z, by = r.id })
	if #S.traps > 12 then
		local old = table.remove(S.traps, 1)
		sendAll("trapRemove", { id = old.id, burst = false })
	end
end

local function removeTrap(t, burst: boolean)
	local i = table.find(S.traps, t)
	if i then
		table.remove(S.traps, i)
		sendAll("trapRemove", { id = t.id, burst = burst })
	end
end

local function useItem(r: Racer): boolean
	local b = r.body
	local item = b.item
	if not item or (b.roulette or 0) > 0 then
		return false
	end
	b.item = nil
	b.itemHeld = 0
	if item == "turbo" then
		if r.isBot then
			b:addBoost(2.0, 1.42, "item")
		else
			send(r.player, "boost", { time = 2.0, power = 1.42, kind = "item" })
		end
	elseif item == "shield" then
		b.shieldTimer = 7.5
		send(r.player, "shield", { time = 7.5 })
	elseif item == "orb" then
		fireOrb(r)
	elseif item == "ice" then
		dropTrap(r)
	end
	sendAll("itemUsed", { id = r.id, item = item })
	return true
end

local function updateItems(dt: number)
	local tr = S.track
	-- кристаллы
	for i, bx in S.boxes do
		if not bx.active then
			bx.timer -= dt
			if bx.timer <= 0 then
				bx.active = true
			end
		else
			for _, r in S.racers do
				if r.isBot and not r.finished then
					local k = r.body
					local dx, dz = k.pos.X - bx.pos.X, k.pos.Z - bx.pos.Z
					local dy = k.pos.Y + 0.8 - bx.pos.Y
					if dx * dx + dz * dz < 2.3 * 2.3 and math.abs(dy) < 2.4 then
						bx.active = false
						bx.timer = Layout.BOX_RESPAWN
						sendAll("boxTaken", { i = i, by = r.id })
						giveBox(r)
						break
					end
				end
			end
		end
	end
	-- рулетка и удержание предмета
	for _, r in S.racers do
		local b = r.body
		if (b.roulette or 0) > 0 then
			b.roulette -= dt
			if b.roulette <= 0 then
				b.item = b.pendingItem
				b.itemHeld = 0
				send(r.player, "item", { item = b.item })
			end
		elseif b.item then
			b.itemHeld += dt
		end
		if r.hitCd > 0 then
			r.hitCd -= dt
		end
		if not r.isBot and b.shieldTimer > 0 then
			b.shieldTimer -= dt
		end
	end
	-- сферы
	for i = #S.orbs, 1, -1 do
		local o = S.orbs[i]
		o.age += dt
		o.life -= dt
		local homing = false
		local tb = o.body
		if tb and not (o.target and o.target.finished) then
			local d = (o.pos - tb.pos).Magnitude
			local ds = tr:deltaProgress(o.s, tb.progress)
			if d < 16 or (ds < 12 and ds > -4) then
				homing = true
			else
				o.lat += (tb.lateral - o.lat) * (1 - math.exp(-dt * 2.5))
			end
		end
		if homing then
			local tgt = tb.pos + Vector3.new(0, 0.8, 0)
			local dir = tgt - o.pos
			local len = dir.Magnitude
			if len > 1e-3 then
				o.pos += dir / len * math.min(len, o.speed * dt)
			end
			local p = tr:project(o.pos, o.idx)
			o.idx = p.nearest
			o.s = p.f * tr.spacing
			o.lat = p.lateral
		else
			o.s += o.speed * dt
			local fr = tr:frameAtProgress(o.s)
			local lim = fr.hw + fr.wall - 1
			o.lat = math.clamp(o.lat, -lim, lim)
			o.pos = fr.pos + fr.right * o.lat + fr.up * 0.9
			o.idx = fr.index
		end
		local done = o.life <= 0
		if not done then
			for _, r in S.racers do
				if not (r == o.owner and o.age < 0.6) and not (r.finished and r ~= o.target) then
					local k = r.body
					local dx, dy, dz = k.pos.X - o.pos.X, k.pos.Y + 0.8 - o.pos.Y, k.pos.Z - o.pos.Z
					-- у игроков позиция приходит с задержкой — радиус чуть больше
					local R = if r.isBot then 1.9 else 2.6
					if dx * dx + dy * dy + dz * dz < R * R then
						hitRacer(r, "spin", o.owner)
						done = true
						break
					end
				end
			end
		end
		if not done then
			for _, t in S.traps do
				if (t.pos - o.pos).Magnitude < 2 then
					removeTrap(t, true)
					done = true
					break
				end
			end
		end
		if done then
			table.remove(S.orbs, i)
			sendAll("orbEnd", { id = o.id, x = o.pos.X, y = o.pos.Y, z = o.pos.Z })
		end
	end
	-- ловушки (ботов проверяет сервер, игроки сообщают сами)
	for i = #S.traps, 1, -1 do
		local t = S.traps[i]
		t.age += dt
		if t.age >= 0.35 then
			for _, r in S.racers do
				if r.isBot and not r.finished then
					local k = r.body
					local dx, dz, dy = k.pos.X - t.pos.X, k.pos.Z - t.pos.Z, k.pos.Y - t.pos.Y
					if dx * dx + dz * dz < 1.7 * 1.7 and math.abs(dy) < 1.6 and not k.airborne then
						hitRacer(r, "freeze", t.owner)
						removeTrap(t, true)
						break
					end
				end
			end
		end
	end
end

local function updateCoins(dt: number)
	for i, c in S.coins do
		if c.t > 0 then
			c.t -= dt
		else
			for _, r in S.racers do
				if r.isBot and not r.finished then
					local k = r.body
					local dx, dz = k.pos.X - c.pos.X, k.pos.Z - c.pos.Z
					if dx * dx + dz * dz <= 1.75 * 1.75 and math.abs(k.pos.Y + 0.9 - c.pos.Y) <= 2.2 then
						c.t = Layout.COIN_RESPAWN
						k:addCoin()
						r.coinsTotal += 1
						sendAll("coinTaken", { i = i, by = r.id })
						break
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------- гонка

local function updateOrder()
	table.sort(S.order, function(a, b)
		if a.finished and b.finished then
			return (a.finishTime or 0) < (b.finishTime or 0)
		end
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.body.totalProgress ~= b.body.totalProgress then
			return a.body.totalProgress > b.body.totalProgress
		end
		return a.id < b.id
	end)
end

local function finishRacer(r: Racer)
	if r.finished then
		return
	end
	r.finished = true
	r.body.finished = true
	r.finishTime = now() - S.raceStart
	S.finishedCount += 1
	if not r.isBot and not S.firstHumanFinish then
		S.firstHumanFinish = now()
	end
	sendAll("finish", { id = r.id, place = S.finishedCount, time = r.finishTime })
end

local function racingInput()
	return { steer = 0, throttle = 0, brake = 0, driftHeld = false, driftPressed = false, useItem = false, useBoost = false }
end

local function botView()
	local karts, order = {}, {}
	for _, r in S.racers do
		table.insert(karts, r.body)
	end
	for _, r in S.order do
		table.insert(order, r.body)
	end
	local traps = {}
	for _, t in S.traps do
		table.insert(traps, { s = t.s, lat = t.lat, id = t.id })
	end
	local orbs = {}
	for _, o in S.orbs do
		table.insert(orbs, { target = o.body, pos = o.pos })
	end
	local boxes = {}
	for _, b in S.boxes do
		table.insert(boxes, { s = b.s, lat = b.lat, active = b.active })
	end
	local coins = {
		ahead = function(_, s: number, maxDs: number)
			local best, bd = nil, maxDs
			for _, c in S.coins do
				if c.t <= 0 then
					local ds = S.track:deltaProgress(s, c.s)
					if ds > 5 and ds < bd then
						bd = ds
						best = c
					end
				end
			end
			return best
		end,
	}
	return { karts = karts, order = order, laps = Config.LAPS, boxes = boxes, traps = traps, orbs = orbs, coins = coins }
end

local SUBSTEP = 1 / 120

local function stepBots(dt: number, racing: boolean)
	local view = botView()
	-- резинка: боты держатся рядом со средним игроком
	local hs = humans()
	local avg = nil
	if #hs > 0 then
		local sum = 0
		for _, h in hs do
			sum += h.body.totalProgress
		end
		avg = sum / #hs
	end
	local inputs = {}
	for _, r in S.racers do
		if r.isBot then
			local k = r.body
			local inp
			if not racing then
				inp = racingInput()
			else
				inp = r.bot:think(dt, view)
				if r.finished then
					inp.useItem = false
					inp.useBoost = false
				end
				if inp.useItem and k.item then
					useItem(r)
				end
				if inp.useBoost then
					k:useBoost()
				end
				if avg then
					local gap = k.totalProgress - avg
					k.rubber = 1 + math.clamp(-gap / 260, -0.6, 1) * diff.rubber
				end
			end
			inputs[r] = inp
		end
	end
	local steps = math.min(6, math.max(1, math.ceil(dt / SUBSTEP - 0.05)))
	local h = dt / steps
	for _ = 1, steps do
		for r, inp in inputs do
			r.body:step(h, inp)
			inp.driftPressed = false
		end
		-- столкновения: бот толкает только себя; игроки — по последнему присланному положению
		for r in inputs do
			local k = r.body
			for _, o in S.racers do
				if o ~= r then
					local ob = o.body
					local vx = math.sin(ob.moveHeading) * ob.speed
					local vz = math.cos(ob.moveHeading) * ob.speed
					if not o.isBot then
						k:collideWith(ob.pos.X, ob.pos.Y, ob.pos.Z, vx, vz, ob.shieldTimer > 0)
					else
						local ovx, ovz = ob:velocityXZ()
						k:collideWith(ob.pos.X, ob.pos.Y, ob.pos.Z, ovx, ovz, ob.shieldTimer > 0)
					end
				end
			end
		end
	end
	for r in inputs do
		local k = r.body
		if racing then
			local others = {}
			for _, o in S.racers do
				if o ~= r then
					table.insert(others, { progress = o.body.progress, lateral = o.body.lateral, y = o.body.pos.Y, speed = o.body.speed })
				end
			end
			k:updateDraft(dt, others)
		end
		for _, e in k.events do
			if e.type == "lapCross" and e.forward and racing and not r.finished and k.lapsDone >= Config.LAPS then
				finishRacer(r)
			end
		end
		table.clear(k.events)
	end
end

local function revBots(dt: number, stateTime: number)
	for _, r in S.racers do
		if r.isBot then
			r.body:revOnGrid(dt, r.bot:revThrottle(dt, stateTime))
		end
	end
end

local function results()
	updateOrder()
	local final = S.raceNum >= #Config.TRACK_ORDER
	local list = {}
	for place, r in S.order do
		local gain = Config.GP_POINTS[place] or 0
		S.gp.points[r.key] = (S.gp.points[r.key] or 0) + gain
		table.insert(list, {
			id = r.id,
			name = r.name,
			charId = r.charId,
			isBot = r.isBot,
			place = place,
			time = r.finishTime,
			finished = r.finished,
			gain = gain,
			total = S.gp.points[r.key],
			key = r.key,
		})
	end
	local standings = {}
	for key, pts in S.gp.points do
		table.insert(standings, { key = key, name = S.gp.names[key] or key, total = pts })
	end
	table.sort(standings, function(a, b)
		if a.total ~= b.total then
			return a.total > b.total
		end
		return a.key < b.key
	end)
	local data = { list = list, final = final, standings = standings, raceNum = S.raceNum, raceCount = #Config.TRACK_ORDER, trackId = S.trackId }
	S.lastResults = data
	sendAll("results", data)

	-- награды игрокам
	for place, r in S.order do
		local p = r.player
		if p and p.Parent and Profiles.get(p) then
			local prof = Profiles.get(p)
			local reward = { collected = r.coinsTotal, placeBonus = Config.PLACE_COINS[place] or 0, cupBonus = 0, cupPlace = 0 }
			if final then
				for i, st in standings do
					if st.key == r.key then
						reward.cupPlace = i
						reward.cupBonus = Config.CUP_COINS[i] or 0
					end
				end
				if reward.cupPlace >= 1 and reward.cupPlace <= 3 then
					prof.cups = (prof.cups or 0) + 1
				end
			end
			reward.total = reward.collected + reward.placeBonus + reward.cupBonus
			prof.coins += reward.total
			prof.races = (prof.races or 0) + 1
			if place == 1 then
				prof.wins = (prof.wins or 0) + 1
			end
			Profiles.markDirty(p)
			send(p, "reward", reward)
			send(p, "profile", Profiles.view(p))
		end
	end
	setPhase("results")
end

local function snapshot()
	local karts = {}
	for _, r in S.racers do
		local st
		if r.isBot then
			st = Net.fromKart(r.id, r.body)
		else
			st = r.body.net
			if not st then
				st = {
					id = r.id,
					x = r.body.pos.X,
					y = r.body.pos.Y,
					z = r.body.pos.Z,
					heading = r.body.heading,
					moveHeading = r.body.moveHeading,
					speed = 0,
					progress = r.body.progress,
					lateral = r.body.lateral,
					lapsDone = -1,
					airborne = false,
					drifting = false,
					driftDir = 1,
					finished = false,
					shield = false,
					frozen = false,
					spinning = false,
					offroad = false,
					driftLevel = 0,
					boostKind = "",
					coins = 0,
					trick = false,
				}
			end
			st.id = r.id
			st.finished = r.finished
		end
		table.insert(karts, st)
	end
	local orbs = {}
	for _, o in S.orbs do
		table.insert(orbs, { id = o.id, x = o.pos.X, y = o.pos.Y, z = o.pos.Z })
	end
	RE_Snap:FireAllClients(Net.packSnapshot(now(), karts, orbs))
end

-- ---------------------------------------------------------------- сеть: от клиентов

RE_State.OnServerEvent:Connect(function(p: Player, b: any)
	if typeof(b) ~= "buffer" or buffer.len(b) ~= Net.KART_BYTES then
		return
	end
	local r = S.byPlayer[p]
	if not r or not (S.phase == "countdown" or S.phase == "race" or S.phase == "intro") then
		return
	end
	local ok, st = pcall(Net.readKart, b, 0)
	if not ok then
		return
	end
	for _, v in { st.x, st.y, st.z, st.heading, st.moveHeading, st.speed, st.progress, st.lateral } do
		if v ~= v or math.abs(v) > 1e5 then
			return
		end
	end
	local px = r.body
	local L = S.track.length
	if S.phase ~= "race" then
		-- до старта карт стоит на своём месте
		st.lapsDone = -1
	else
		-- круг засчитывается только при честном пересечении линии (прогресс перескочил конец трассы)
		local old = px.lapsDone
		if st.lapsDone > old then
			if st.lapsDone == old + 1 and px.progress > L * 0.6 and st.progress < L * 0.4 then
				px.lapsDone = st.lapsDone
			end
		elseif st.lapsDone < old then
			if st.lapsDone == old - 1 and px.progress < L * 0.4 and st.progress > L * 0.6 then
				px.lapsDone = st.lapsDone
			end
		end
		st.lapsDone = px.lapsDone
	end
	px.pos = Vector3.new(st.x, st.y, st.z)
	px.heading = st.heading
	px.moveHeading = st.moveHeading
	px.speed = math.clamp(st.speed, -20, 120)
	px.progress = math.clamp(st.progress, 0, L)
	px.lateral = st.lateral
	px.airborne = st.airborne
	px.totalProgress = px.lapsDone * L + px.progress
	px.net = st
	r.lastPacket = now()
	if S.phase == "race" and not r.finished and px.lapsDone >= Config.LAPS then
		finishRacer(r)
	end
end)

RE_Action.OnServerEvent:Connect(function(p: Player, kind: any, data: any)
	if kind == "hello" then
		-- профиль грузится из DataStore асинхронно — подождём его
		local waited = 0
		while not Profiles.get(p) and waited < 15 and p.Parent do
			waited += task.wait(0.2)
		end
		if not p.Parent then
			return
		end
		if not Profiles.get(p) then
			Profiles.load(p)
		end
		S.ready[p] = true
		send(p, "profile", Profiles.view(p))
		if S.phase ~= "lobby" and S.track then
			send(p, "setup", setupView(p))
			if S.phase == "results" and S.lastResults then
				send(p, "results", S.lastResults)
			end
		end
		return
	end
	local r = S.byPlayer[p]
	if not r or S.phase ~= "race" or r.finished then
		return
	end
	local body = r.body
	if kind == "use" then
		useItem(r)
	elseif kind == "box" and type(data) == "number" then
		local bx = S.boxes[data]
		if bx and bx.active and (bx.pos - body.pos).Magnitude < 12 then
			bx.active = false
			bx.timer = Layout.BOX_RESPAWN
			sendAll("boxTaken", { i = data, by = r.id })
			giveBox(r)
		end
	elseif kind == "coin" and type(data) == "number" then
		local c = S.coins[data]
		if c and c.t <= 0 and (c.pos - body.pos).Magnitude < 10 then
			c.t = Layout.COIN_RESPAWN
			r.coinsTotal += 1
			sendAll("coinTaken", { i = data, by = r.id })
		end
	elseif kind == "trap" and type(data) == "number" then
		for _, t in S.traps do
			if t.id == data and (t.pos - body.pos).Magnitude < 10 then
				r.hitCd = 2.6
				removeTrap(t, true)
				sendAll("hitFx", { id = r.id, kind = "freeze", by = t.owner.id })
				break
			end
		end
	end
end)

RF_Shop.OnServerInvoke = function(p: Player, action: any, id: any)
	local prof = Profiles.get(p)
	if not prof then
		return nil
	end
	local c = if type(id) == "string" then CHAR_BY_ID[id] else nil
	if action == "buy" and c and not prof.owned[c.id] then
		if prof.coins >= c.price then
			prof.coins -= c.price
			prof.owned[c.id] = true
			prof.selected = c.id
			Profiles.save(p)
		end
	elseif action == "select" and c and prof.owned[c.id] then
		prof.selected = c.id
		Profiles.markDirty(p)
	end
	return Profiles.view(p)
end

-- ---------------------------------------------------------------- игроки

Players.PlayerAdded:Connect(function(p)
	Profiles.load(p)
end)
for _, p in Players:GetPlayers() do
	task.spawn(Profiles.load, p)
end

Players.PlayerRemoving:Connect(function(p)
	S.ready[p] = nil
	local r = S.byPlayer[p]
	if r then
		S.byPlayer[p] = nil
		local i = table.find(S.racers, r)
		if i then
			table.remove(S.racers, i)
		end
		local j = table.find(S.order, r)
		if j then
			table.remove(S.order, j)
		end
		sendAll("leave", { id = r.id })
	end
	Profiles.release(p)
end)

-- ---------------------------------------------------------------- главный цикл

newGP()
setPhase("lobby")

local snapAcc = 0
RunService.Heartbeat:Connect(function(dt: number)
	dt = math.min(dt, 0.1)
	local t = now() - S.phaseStart
	local readyCount = 0
	for p in S.ready do
		if p.Parent then
			readyCount += 1
		end
	end

	if S.phase == "lobby" then
		if readyCount == 0 then
			S.phaseStart = now() -- ждём первого игрока
			ReplicatedStorage:SetAttribute("SD_PhaseStart", S.phaseStart)
		elseif t >= Config.LOBBY_TIME then
			startRace()
		end
		return
	end

	if S.phase == "intro" then
		if t >= Config.INTRO_TIME then
			setPhase("countdown")
		end
	elseif S.phase == "countdown" then
		revBots(dt, t)
		if t >= Config.COUNT_TIME then
			for _, r in S.racers do
				if r.isBot then
					r.body:launch()
					table.clear(r.body.events)
				end
			end
			S.raceStart = now()
			setPhase("race")
			sendAll("go", { raceStart = S.raceStart })
		end
	end

	if S.phase == "intro" or S.phase == "countdown" or S.phase == "race" then
		local racing = S.phase == "race"
		stepBots(dt, racing)
		if racing then
			updateItems(dt)
			updateCoins(dt)
			updateOrder()
			-- конец гонки
			local hs = humans()
			local allDone = #hs > 0
			for _, h in hs do
				if not h.finished then
					allDone = false
				end
			end
			if allDone and not S.allHumansDoneAt then
				S.allHumansDoneAt = now()
			end
			local tnow = now()
			if
				#hs == 0
				or (S.allHumansDoneAt and tnow - S.allHumansDoneAt > 3)
				or (S.firstHumanFinish and tnow - S.firstHumanFinish > Config.FINISH_TIMEOUT)
				or tnow - S.raceStart > Config.RACE_TIMEOUT
			then
				if #hs == 0 then
					newGP()
					setPhase("lobby")
					sendAll("lobby", {})
					return
				end
				results()
			end
		end
		snapAcc += dt
		if snapAcc >= 1 / 20 then
			snapAcc = 0
			snapshot()
		end
	elseif S.phase == "results" then
		local final = S.raceNum >= #Config.TRACK_ORDER
		if t >= (if final then Config.GP_RESULTS_TIME else Config.RESULTS_TIME) then
			if readyCount == 0 then
				newGP()
				setPhase("lobby")
			elseif final then
				newGP()
				setPhase("lobby")
				sendAll("lobby", {})
			else
				startRace()
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">Profiles</string>
        <string name="Source"><![CDATA[--!strict
-- Профили игроков в DataStore: кошелёк монет, купленные гонщики, выбранный гонщик, лучшие кубки.
-- В Studio без включённого "Enable Studio Access to API Services" работает в памяти (с предупреждением).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)

local Profiles = {}

local store: DataStore? = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE)
	end)
	if ok then
		store = res
	else
		warn("[SakuraDrift] DataStore недоступен, прогресс не сохранится:", res)
	end
end

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}

local function defaults()
	local owned = {}
	for _, c in Characters do
		if c.price == 0 then
			owned[c.id] = true
		end
	end
	return { coins = 0, owned = owned, selected = "sakura", cups = 0, races = 0, wins = 0 }
end

local function key(p: Player): string
	return "u" .. p.UserId
end

function Profiles.load(p: Player)
	local data = nil
	if store then
		for attempt = 1, 3 do
			local ok, res = pcall(function()
				return (store :: DataStore):GetAsync(key(p))
			end)
			if ok then
				data = res
				break
			end
			warn("[SakuraDrift] загрузка профиля, попытка", attempt, res)
			task.wait(1.5 * attempt)
		end
	end
	local prof = defaults()
	if type(data) == "table" then
		for k, v in data do
			prof[k] = v
		end
		for id, v in defaults().owned do
			prof.owned[id] = v
		end
	end
	profiles[p] = prof
	return prof
end

function Profiles.get(p: Player)
	return profiles[p]
end

function Profiles.save(p: Player)
	local prof = profiles[p]
	if not prof or not store then
		return
	end
	dirty[p] = nil
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(key(p), prof)
	end)
	if not ok then
		warn("[SakuraDrift] сохранение профиля:", err)
		dirty[p] = true
	end
end

function Profiles.markDirty(p: Player)
	dirty[p] = true
end

function Profiles.release(p: Player)
	Profiles.save(p)
	profiles[p] = nil
	dirty[p] = nil
end

--- То, что видит клиент.
function Profiles.view(p: Player)
	local prof = profiles[p]
	if not prof then
		return nil
	end
	return { coins = prof.coins, owned = prof.owned, selected = prof.selected, cups = prof.cups, races = prof.races, wins = prof.wins }
end

function Profiles.addCoins(p: Player, n: number)
	local prof = profiles[p]
	if prof then
		prof.coins += n
		dirty[p] = true
	end
end

-- периодическое сохранение и при выключении сервера
task.spawn(function()
	while true do
		task.wait(60)
		for p in dirty do
			if p.Parent then
				Profiles.save(p)
			end
		end
	end
end)

game:BindToClose(function()
	for _, p in Players:GetPlayers() do
		Profiles.save(p)
	end
end)

return Profiles
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="21">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[--!strict
-- Звук: музыка трассы, мотор (петля, высота — от оборотов через PlaybackSpeed), визг дрифта,
-- реактивный шум буста и короткие эффекты. ID берутся из Shared/Config.Sounds; пустой ID — тишина.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Audio = {}
local SND = Config.Sounds

local IDLE_HZ, MAX_HZ = 32, 200 -- как в веб-версии: частота вспышек от холостых до отсечки
local function loopHz(v: number, rpm: number): number
	return if v and v > 0 then v else IDLE_HZ + (MAX_HZ - IDLE_HZ) * rpm
end

local group = Instance.new("SoundGroup")
group.Name = "SakuraSfx"
group.Volume = 0.8
group.Parent = SoundService
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "SakuraMusic"
musicGroup.Volume = 0.45
musicGroup.Parent = SoundService

local function mk(id: string, looped: boolean, vol: number, g: SoundGroup): Sound?
	if not id or id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = looped
	s.Volume = vol
	s.SoundGroup = g
	s.Parent = SoundService
	return s
end

local engine = mk(SND.engine.loop, true, 0, group)
local engineIdle = mk(SND.engine.idle, true, 0, group)
local engineLim = mk(SND.engine.limiter, true, 0, group)
local drift = mk(SND.loop.drift, true, 0, group)
local jet = mk(SND.loop.boost, true, 0, group)
local loops = { engine, engineIdle, engineLim, drift, jet }

local music: Sound? = nil
local musicKey = ""

function Audio.playMusic(key: string)
	if key == musicKey then
		return
	end
	musicKey = key
	if music then
		music:Stop()
		music:Destroy()
		music = nil
	end
	local s = mk(SND.music[key] or "", true, 1, musicGroup)
	if s then
		s:Play()
		music = s
	end
end

function Audio.setMusicSpeed(x: number)
	if music then
		music.PlaybackSpeed = x
	end
end

local cache: { [string]: Sound } = {}
function Audio.sfx(key: string, vol: number?, pitch: number?)
	local id = SND.sfx[key]
	if not id or id == "" then
		return
	end
	local s = cache[key]
	if not s then
		local ns = Instance.new("Sound")
		ns.SoundId = id
		ns.SoundGroup = group
		ns.Parent = SoundService
		cache[key] = ns
		s = ns
	end
	local snd = s :: Sound
	snd.Volume = vol or 0.8
	snd.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(snd)
end

local running = false
function Audio.startEngine()
	if running then
		return
	end
	running = true
	for _, s in loops do
		if s then
			s.Volume = 0
			s:Play()
		end
	end
end

function Audio.stopEngine()
	running = false
	for _, s in loops do
		if s then
			s:Stop()
		end
	end
end

local function approach(s: Sound?, prop: string, v: number, k: number)
	if s then
		local cur = (s :: any)[prop];
		(s :: any)[prop] = cur + (v - cur) * k
	end
end

--- st: { rpm 0..1, load 0..1, limiter, drifting, driftLevel, boosting, speed01, dt }
function Audio.updateEngine(st)
	if not running then
		return
	end
	local k = 1 - math.exp(-(st.dt or 1 / 60) * 18)
	local rpm = math.clamp(st.rpm, 0, 1.05)
	local f = IDLE_HZ + (MAX_HZ - IDLE_HZ) * rpm
	local idleMix = math.clamp(1 - rpm / 0.18, 0, 1)
	local lvl = 0.55 * (0.72 + 0.28 * st.load) * (0.75 + 0.35 * rpm)
	if engine then
		engine.PlaybackSpeed = math.clamp(f / loopHz(SND.engineLoopHz, 0.45), 0.25, 3)
		approach(engine, "Volume", if st.limiter then 0 else lvl * (1 - idleMix * (if engineIdle then 1 else 0)), k)
	end
	if engineIdle then
		engineIdle.PlaybackSpeed = math.clamp(f / loopHz(SND.engineIdleHz, 0), 0.5, 2)
		approach(engineIdle, "Volume", if st.limiter then 0 else lvl * idleMix, k)
	end
	if engineLim then
		engineLim.PlaybackSpeed = math.clamp(f / loopHz(SND.engineLimiterHz, 0.96), 0.5, 2)
		approach(engineLim, "Volume", if st.limiter then lvl else 0, k)
	elseif engine and st.limiter then
		approach(engine, "Volume", lvl * 0.7, k)
	end
	approach(drift, "Volume", if st.drifting then 0.35 + 0.1 * (st.driftLevel or 0) else 0, k)
	if drift then
		drift.PlaybackSpeed = 0.9 + 0.08 * (st.driftLevel or 0)
	end
	approach(jet, "Volume", if st.boosting then 0.4 else 0, k)
end

-- события карта → звуки (как в веб-версии)
local EVENT_SFX = {
	driftStart = "driftStart",
	meterSegment = "driftLevel",
	boostFire = nil,
	hop = nil,
	jump = "jump",
	land = "land",
	trick = "trick",
	trickBoost = "boost",
	wallHit = "wallHit",
	bump = "bump",
	coin = "coin",
	shieldBreak = "shieldBreak",
	slipstream = "boost",
	wrongWay = nil,
	respawn = "uiBack",
}

function Audio.kartEvent(e)
	local t = e.type
	if t == "boostFire" then
		Audio.sfx("miniturbo" .. tostring(math.clamp(e.level or 1, 1, 3)), 0.9)
	elseif t == "boost" and e.added and e.kind == "pad" then
		Audio.sfx("boost", 0.8)
	elseif t == "hit" then
		Audio.sfx(if e.kind == "freeze" then "freeze" else "spin", 0.9)
	elseif t == "unfreeze" then
		Audio.sfx("shatter", 0.8)
	elseif t == "wrongWay" and e.on then
		Audio.sfx("wrongWay", 0.7)
	elseif t == "launch" then
		if e.result == "perfect" or e.result == "good" then
			Audio.sfx("boost", 1)
		elseif e.result == "spin" then
			Audio.sfx("backfire", 0.9)
		end
	else
		local key = EVENT_SFX[t]
		if key then
			local vol = 0.7
			if t == "wallHit" or t == "bump" then
				vol = math.clamp((e.strength or 6) / 14, 0.25, 0.9)
			end
			Audio.sfx(key, vol)
		end
	end
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">Boot</string>
          <string name="Source"><![CDATA[--!strict
-- Экран загрузки и диагностика: показывает, на каком шаге запуск, и выводит на экран ошибки
-- клиента и сервера (иначе при сбое виден только пустой мир). Ни от чего не зависит.
local Players = game:GetService("Players")
local LogService = game:GetService("LogService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "SakuraBoot"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -40, 0, 60)
status.Position = UDim2.new(0, 20, 0.5, -30)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.new(1, 1, 1)
status.TextStrokeTransparency = 0
status.Font = Enum.Font.GothamBold
status.TextSize = 28
status.Text = "SAKURA DRIFT — загрузка…"
status.Parent = gui

local errBox = Instance.new("TextLabel")
errBox.Size = UDim2.new(1, -40, 0.45, 0)
errBox.Position = UDim2.new(0, 20, 0.55, 0)
errBox.BackgroundColor3 = Color3.fromRGB(40, 10, 20)
errBox.BackgroundTransparency = 0.2
errBox.TextColor3 = Color3.fromRGB(255, 190, 190)
errBox.Font = Enum.Font.Code
errBox.TextSize = 15
errBox.TextWrapped = true
errBox.TextXAlignment = Enum.TextXAlignment.Left
errBox.TextYAlignment = Enum.TextYAlignment.Top
errBox.Visible = false
errBox.Parent = gui

local clientLines: { string } = {}
local serverText = ""
local function refresh()
	local parts = {}
	if #clientLines > 0 then
		table.insert(parts, "КЛИЕНТ:\n" .. table.concat(clientLines, "\n"))
	end
	if serverText ~= "" then
		table.insert(parts, "СЕРВЕР:\n" .. serverText)
	end
	errBox.Text = table.concat(parts, "\n\n")
	errBox.Visible = #parts > 0
end

LogService.MessageOut:Connect(function(msg: string, kind: Enum.MessageType)
	if kind == Enum.MessageType.MessageError or kind == Enum.MessageType.MessageWarning then
		table.insert(clientLines, string.sub(msg, 1, 300))
		if #clientLines > 10 then
			table.remove(clientLines, 1)
		end
		refresh()
	end
end)

task.spawn(function()
	local log = ReplicatedStorage:WaitForChild("SakuraServerLog", 20)
	if log and log:IsA("StringValue") then
		serverText = log.Value
		refresh()
		log.Changed:Connect(function()
			serverText = log.Value
			refresh()
		end)
	end
end)

local t0 = os.clock()
while true do
	local stage = player:GetAttribute("SakuraStage")
	if stage == "ok" then
		status.Visible = false
		-- ошибки во время игры показываем маленькой плашкой внизу
		errBox.Size = UDim2.new(0.5, 0, 0.2, 0)
		errBox.Position = UDim2.new(0, 10, 0.78, 0)
		errBox.TextSize = 12
		break
	end
	status.Text = string.format("SAKURA DRIFT — загрузка: %s (%d с)", tostring(stage or "старт скриптов"), math.floor(os.clock() - t0))
	task.wait(0.25)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--!strict
-- Интерфейс: место и круг, скорость, шкала буста (3 деления), предмет с рулеткой, монеты, слипстрим,
-- обороты на старте с зелёной зоной, отсчёт и подсказки, мини-таблица мест, лобби и гараж гонщиков,
-- итоги гонки и Гран-при, сенсорные кнопки на телефоне.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Characters)
local Layout = require(Shared.Layout)
local Kart = require(Shared.Kart)
local Input = require(script.Parent.Input)

local Hud = {}

local PINK = Color3.fromRGB(255, 93, 147)
local CYAN = Color3.fromRGB(57, 243, 255)
local DARK = Color3.fromRGB(26, 20, 44)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 200, 40)
local NUM = Enum.Font.FredokaOne
local TXT = Enum.Font.GothamBlack
local TXT2 = Enum.Font.GothamBold

local function new(class: string, props: { [string]: any }, children: { Instance }?): any
	local o = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(o :: any)[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = o
	end
	if props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(r: number): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function stroke(c: Color3, t: number): UIStroke
	return new("UIStroke", { Color = c, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function label(props: { [string]: any }): TextLabel
	local p = {
		BackgroundTransparency = 1,
		TextColor3 = WHITE,
		Font = TXT,
		TextScaled = true,
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = DARK,
	}
	for k, v in props do
		p[k] = v
	end
	return new("TextLabel", p)
end

local function panel(props: { [string]: any }): Frame
	local p = { BackgroundColor3 = DARK, BackgroundTransparency = 0.25, BorderSizePixel = 0 }
	for k, v in props do
		p[k] = v
	end
	local f = new("Frame", p, { corner(12) })
	return f
end

local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local p = {
		BackgroundColor3 = PINK,
		AutoButtonColor = true,
		TextColor3 = WHITE,
		Font = TXT,
		TextScaled = true,
		BorderSizePixel = 0,
	}
	for k, v in props do
		p[k] = v
	end
	local b = new(
		"TextButton",
		p,
		{
			corner(10),
			new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
		}
	)
	b.Activated:Connect(onClick)
	return b
end

local gui: ScreenGui
local E: { [string]: any } = {}
local charById = {}
for _, c in Characters do
	charById[c.id] = c
end

local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

function Hud.init(callbacks)
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = new("ScreenGui", { Name = "SakuraHud", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg })
	E.callbacks = callbacks

	-- ---- гонка
	local race = new("Frame", { Name = "Race", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	E.race = race
	E.place = label({
		Size = UDim2.fromOffset(150, 96),
		Position = UDim2.fromOffset(18, 18),
		Font = NUM,
		Text = "1",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = WHITE,
		TextStrokeColor3 = PINK,
		TextStrokeTransparency = 0,
		Parent = race,
	})
	E.placeOf = label({
		Size = UDim2.fromOffset(80, 34),
		Position = UDim2.fromOffset(84, 66),
		Font = NUM,
		Text = "/8",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = race,
	})
	E.lap = label({
		Size = UDim2.fromOffset(220, 30),
		Position = UDim2.fromOffset(20, 116),
		Text = "КРУГ 1/3",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = race,
	})
	E.time = label({
		Size = UDim2.fromOffset(220, 24),
		Position = UDim2.fromOffset(20, 146),
		Font = NUM,
		Text = "0:00.00",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = race,
	})

	-- мини-таблица мест
	local board = new(
		"Frame",
		{ Size = UDim2.fromOffset(190, 8 * 22), Position = UDim2.fromOffset(18, 182), BackgroundTransparency = 1, Parent = race },
		{ new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) }
	)
	E.board = board
	E.boardRows = {}
	for i = 1, 8 do
		local row = panel({ Size = UDim2.fromOffset(190, 20), LayoutOrder = i, BackgroundTransparency = 0.45, Parent = board })
		local num = label({ Size = UDim2.fromOffset(22, 20), Font = NUM, Text = tostring(i), Parent = row })
		local nm = label({
			Size = UDim2.new(1, -30, 1, -4),
			Position = UDim2.fromOffset(28, 2),
			Font = TXT2,
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		E.boardRows[i] = { row = row, num = num, name = nm }
	end

	-- предмет и монеты (справа сверху)
	local itemBox = panel({ Size = UDim2.fromOffset(96, 96), Position = UDim2.new(1, -116, 0, 18), Parent = race }, {})
	stroke(WHITE, 3).Parent = itemBox
	E.itemBox = itemBox
	E.itemIcon = label({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.05), Font = NUM, Text = "", Parent = itemBox })
	E.itemName = label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, 2), Font = TXT2, Text = "", Parent = itemBox })
	E.coins = label({
		Size = UDim2.fromOffset(160, 32),
		Position = UDim2.new(1, -180, 0, 140),
		Font = NUM,
		Text = "● 0",
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = race,
	})
	E.draftBar =
		panel({ Size = UDim2.fromOffset(150, 10), Position = UDim2.new(1, -170, 0, 178), BackgroundTransparency = 0.4, Visible = false, Parent = race })
	E.draftFill = new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(180, 240, 255), BorderSizePixel = 0, Parent = E.draftBar },
		{ corner(5) }
	)
	E.draftLabel = label({
		Size = UDim2.fromOffset(150, 18),
		Position = UDim2.fromOffset(0, -20),
		Font = TXT2,
		Text = "СЛИПСТРИМ",
		TextColor3 = Color3.fromRGB(180, 240, 255),
		Parent = E.draftBar,
	})

	-- скорость и шкала буста (внизу слева)
	E.speed = label({
		Size = UDim2.fromOffset(200, 58),
		Position = UDim2.new(0, 22, 1, -150),
		Font = NUM,
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = race,
	})
	E.speedUnit = label({
		Size = UDim2.fromOffset(80, 22),
		Position = UDim2.new(0, 24, 1, -94),
		Font = TXT2,
		Text = "км/ч",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = race,
	})
	local meter = new(
		"Frame",
		{ Size = UDim2.fromOffset(234, 24), Position = UDim2.new(0, 22, 1, -66), BackgroundTransparency = 1, Parent = race },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) }
	)
	E.meterSegs = {}
	local segCol = { Color3.fromRGB(85, 184, 255), Color3.fromRGB(255, 165, 58), Color3.fromRGB(255, 85, 224) }
	for i = 1, 3 do
		local seg = panel({ Size = UDim2.fromOffset(74, 24), BackgroundTransparency = 0.35, Parent = meter })
		stroke(WHITE, 2).Parent = seg
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = segCol[i], BorderSizePixel = 0, Parent = seg }, { corner(12) })
		E.meterSegs[i] = { seg = seg, fill = fill }
	end
	E.meterHint = label({
		Size = UDim2.fromOffset(234, 18),
		Position = UDim2.new(0, 22, 1, -38),
		Font = TXT2,
		Text = if isTouch then "БУСТ — кнопка ⚡" else "БУСТ — F / X",
		TextTransparency = 0.2,
		Parent = race,
	})

	-- обороты на старте
	local rev = panel({ Size = UDim2.fromOffset(420, 44), Position = UDim2.new(0.5, -210, 1, -170), Visible = false, Parent = gui })
	E.rev = rev
	local Z = Kart.PHYS.revZones
	local function zone(a: number, b: number, c: Color3)
		new("Frame", { Size = UDim2.new(b - a, 0, 1, -16), Position = UDim2.new(a, 0, 0, 8), BackgroundColor3 = c, BorderSizePixel = 0, Parent = rev })
	end
	zone(0, Z.good, Color3.fromRGB(70, 70, 90))
	zone(Z.good, Z.perfect, Color3.fromRGB(80, 200, 110))
	zone(Z.perfect, Z.perfectTop, Color3.fromRGB(60, 255, 120))
	zone(Z.perfectTop, Z.red, Color3.fromRGB(80, 200, 110))
	zone(Z.red, 1, Color3.fromRGB(255, 60, 70))
	E.revNeedle = new(
		"Frame",
		{ Size = UDim2.new(0, 6, 1, 6), Position = UDim2.new(0, -3, 0, -3), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = rev },
		{ corner(3) }
	)
	E.revCharge = new("Frame", { Size = UDim2.new(0, 0, 0, 5), Position = UDim2.new(0, 0, 1, 2), BackgroundColor3 = GOLD, BorderSizePixel = 0, Parent = rev })
	E.revHint = label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 0, -26),
		Font = TXT2,
		Text = if isTouch
			then "Держите ГАЗ в зелёной зоне — рывок на старте!"
			else "Держите ↑/W в зелёной зоне — рывок на старте!",
		Parent = rev,
	})

	-- центр: отсчёт и подсказки
	E.big = label({
		Size = UDim2.fromOffset(600, 140),
		Position = UDim2.new(0.5, -300, 0.22, 0),
		Font = NUM,
		Text = "",
		TextColor3 = WHITE,
		TextStrokeColor3 = PINK,
		TextStrokeTransparency = 0,
		Parent = gui,
	})
	E.callouts = new(
		"Frame",
		{ Size = UDim2.fromOffset(520, 120), Position = UDim2.new(0.5, -260, 0, 14), BackgroundTransparency = 1, Parent = gui },
		{ new("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }) }
	)

	-- баннер фазы (лобби/облёт/зритель)
	E.banner = panel({ Size = UDim2.fromOffset(560, 110), Position = UDim2.new(0.5, -280, 0, 70), Visible = false, Parent = gui })
	E.bannerTitle = label({
		Size = UDim2.new(1, -20, 0, 54),
		Position = UDim2.fromOffset(10, 8),
		Text = "",
		TextColor3 = WHITE,
		TextStrokeColor3 = PINK,
		TextStrokeTransparency = 0,
		Parent = E.banner,
	})
	E.bannerSub = label({ Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 66), Font = TXT2, Text = "", Parent = E.banner })

	-- кошелёк и гараж
	E.wallet = label({
		Size = UDim2.fromOffset(200, 30),
		Position = UDim2.new(1, -220, 1, -48),
		Font = NUM,
		Text = "● 0",
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = gui,
	})
	E.garageBtn = button(
		{ Size = UDim2.fromOffset(200, 50), Position = UDim2.new(1, -220, 1, -110), Text = "ГАРАЖ", Visible = false, Parent = gui },
		function()
			Hud.openGarage(not E.garage.Visible)
		end
	)
	Hud.buildGarage()

	-- итоги
	E.results =
		panel({ Size = UDim2.fromOffset(620, 470), Position = UDim2.new(0.5, -310, 0.5, -235), Visible = false, BackgroundTransparency = 0.12, Parent = gui })
	stroke(PINK, 3).Parent = E.results
	E.resTitle = label({
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.fromOffset(10, 10),
		Text = "ИТОГИ",
		TextColor3 = WHITE,
		TextStrokeColor3 = PINK,
		TextStrokeTransparency = 0,
		Parent = E.results,
	})
	E.resList = new(
		"Frame",
		{ Size = UDim2.new(1, -30, 0, 8 * 34), Position = UDim2.fromOffset(15, 62), BackgroundTransparency = 1, Parent = E.results },
		{ new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) }
	)
	E.resReward = label({ Size = UDim2.new(1, -30, 0, 28), Position = UDim2.new(0, 15, 1, -96), Font = TXT2, Text = "", TextColor3 = GOLD, Parent = E.results })
	E.resNext = label({ Size = UDim2.new(1, -30, 0, 24), Position = UDim2.new(0, 15, 1, -60), Font = TXT2, Text = "", Parent = E.results })

	if isTouch then
		Hud.buildTouch()
	end
end

-- ---------------------------------------------------------------- сенсорные кнопки

function Hud.buildTouch()
	local t = new("Frame", { Name = "Touch", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	E.touch = t
	local function hold(text: string, pos: UDim2, size: number, color: Color3, onDown: () -> (), onUp: () -> ())
		local b = new(
			"TextButton",
			{
				Size = UDim2.fromOffset(size, size),
				Position = pos,
				Text = text,
				BackgroundColor3 = color,
				BackgroundTransparency = 0.25,
				TextColor3 = WHITE,
				Font = TXT,
				TextScaled = true,
				AutoButtonColor = false,
				Parent = t,
			},
			{ new("UICorner", { CornerRadius = UDim.new(1, 0) }), stroke(WHITE, 2) }
		)
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				onDown()
			end
		end)
		b.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				onUp()
			end
		end)
	end
	local tch = Input.touch
	local left, right = false, false
	local function upd()
		tch.steer = (if right then 1 else 0) - (if left then 1 else 0)
	end
	hold("◀", UDim2.new(0, 24, 1, -130), 100, DARK, function()
		left = true
		upd()
	end, function()
		left = false
		upd()
	end)
	hold("▶", UDim2.new(0, 140, 1, -130), 100, DARK, function()
		right = true
		upd()
	end, function()
		right = false
		upd()
	end)
	hold("ГАЗ", UDim2.new(1, -130, 1, -140), 110, Color3.fromRGB(60, 200, 110), function()
		tch.gas = true
	end, function()
		tch.gas = false
	end)
	hold("ТОРМ", UDim2.new(1, -230, 1, -100), 80, Color3.fromRGB(120, 120, 140), function()
		tch.brake = true
	end, function()
		tch.brake = false
	end)
	hold("ДРИФТ", UDim2.new(1, -240, 1, -200), 90, PINK, function()
		tch.drift = true
		Input.press("drift")
	end, function()
		tch.drift = false
	end)
	hold("⚡", UDim2.new(1, -120, 1, -240), 80, Color3.fromRGB(85, 184, 255), function()
		Input.press("boost")
	end, function() end)
	hold("✦", UDim2.new(1, -330, 1, -170), 80, Color3.fromRGB(160, 90, 255), function()
		Input.press("item")
	end, function() end)
	-- на телефоне шкала и скорость — повыше, чтобы не мешали кнопки
	E.speed.Position = UDim2.new(0, 22, 1, -260)
	E.speedUnit.Position = UDim2.new(0, 24, 1, -204)
	E.meterSegs[1].seg.Parent.Position = UDim2.new(0, 22, 1, -176)
	E.meterHint.Visible = false
end

-- ---------------------------------------------------------------- гараж

function Hud.buildGarage()
	local g =
		panel({ Size = UDim2.fromOffset(720, 440), Position = UDim2.new(0.5, -360, 0.5, -220), Visible = false, BackgroundTransparency = 0.08, Parent = gui })
	stroke(PINK, 3).Parent = g
	E.garage = g
	label({
		Size = UDim2.new(1, -20, 0, 42),
		Position = UDim2.fromOffset(10, 8),
		Text = "ГАРАЖ — ВЫБОР ГОНЩИКА",
		TextColor3 = WHITE,
		TextStrokeColor3 = PINK,
		TextStrokeTransparency = 0,
		Parent = g,
	})
	E.garageWallet = label({
		Size = UDim2.fromOffset(200, 26),
		Position = UDim2.new(1, -220, 0, 14),
		Font = NUM,
		Text = "● 0",
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = g,
	})
	local grid = new(
		"ScrollingFrame",
		{
			Size = UDim2.new(1, -24, 1, -110),
			Position = UDim2.fromOffset(12, 56),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = g,
		},
		{
			new("UIGridLayout", { CellSize = UDim2.fromOffset(164, 150), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		}
	)
	E.cards = {}
	for i, c in Characters do
		local card = new("Frame", { BackgroundColor3 = Color3.fromRGB(44, 36, 70), BorderSizePixel = 0, LayoutOrder = i, Parent = grid }, { corner(10) })
		local st = stroke(Color3.fromHex(c.kart), 2)
		st.Parent = card
		new("Frame", { Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = Color3.fromHex(c.kart), BorderSizePixel = 0, Parent = card }, { corner(4) })
		label({
			Size = UDim2.new(1, -10, 0, 24),
			Position = UDim2.fromOffset(5, 12),
			Text = c.emblem .. " " .. c.name,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		label({
			Size = UDim2.new(1, -10, 0, 16),
			Position = UDim2.fromOffset(5, 36),
			Font = TXT2,
			Text = c.title,
			TextTransparency = 0.2,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local y = 56
		for _, s in { { "СКОР", c.stats.speed }, { "РАЗГ", c.stats.accel }, { "УПР", c.stats.handling } } do
			label({
				Size = UDim2.fromOffset(44, 14),
				Position = UDim2.fromOffset(6, y),
				Font = TXT2,
				Text = s[1],
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			})
			local bar = new(
				"Frame",
				{
					Size = UDim2.new(1, -62, 0, 8),
					Position = UDim2.fromOffset(52, y + 3),
					BackgroundColor3 = Color3.fromRGB(70, 60, 100),
					BorderSizePixel = 0,
					Parent = card,
				},
				{ corner(4) }
			)
			new("Frame", { Size = UDim2.fromScale(s[2] / 5, 1), BackgroundColor3 = Color3.fromHex(c.kart), BorderSizePixel = 0, Parent = bar }, { corner(4) })
			y += 17
		end
		local btn = button({ Size = UDim2.new(1, -12, 0, 32), Position = UDim2.new(0, 6, 1, -38), Text = "", Parent = card }, function()
			local cb = E.callbacks
			local prof = E.profile
			if not prof or not cb then
				return
			end
			if prof.owned[c.id] then
				cb.select(c.id)
			else
				cb.buy(c.id)
			end
		end)
		E.cards[c.id] = { card = card, btn = btn, stroke = st }
	end
	button(
		{
			Size = UDim2.fromOffset(160, 40),
			Position = UDim2.new(0.5, -80, 1, -50),
			Text = "ЗАКРЫТЬ",
			BackgroundColor3 = Color3.fromRGB(90, 80, 130),
			Parent = g,
		},
		function()
			Hud.openGarage(false)
		end
	)
end

function Hud.openGarage(on: boolean)
	E.garage.Visible = on
end

function Hud.setProfile(prof)
	if not prof then
		return
	end
	E.profile = prof
	E.wallet.Text = "● " .. tostring(prof.coins)
	E.garageWallet.Text = "● " .. tostring(prof.coins)
	for id, card in E.cards do
		local c = charById[id]
		if prof.selected == id then
			card.btn.Text = "ВЫБРАН"
			card.btn.BackgroundColor3 = Color3.fromRGB(60, 200, 110)
			card.stroke.Thickness = 4
		elseif prof.owned[id] then
			card.btn.Text = "ВЫБРАТЬ"
			card.btn.BackgroundColor3 = PINK
			card.stroke.Thickness = 2
		else
			card.btn.Text = "● " .. tostring(c.price)
			card.btn.BackgroundColor3 = if prof.coins >= c.price then GOLD else Color3.fromRGB(90, 80, 110)
			card.stroke.Thickness = 2
		end
	end
end

-- ---------------------------------------------------------------- состояние экрана

--- mode: 'lobby' | 'intro' | 'countdown' | 'race' | 'results' | 'spectate'
function Hud.setMode(mode: string, info: { [string]: any }?)
	local i = info or {}
	E.mode = mode
	local racing = mode == "countdown" or mode == "race"
	E.race.Visible = racing
	if E.touch then
		E.touch.Visible = racing
	end
	E.rev.Visible = mode == "countdown" and i.onGrid == true
	E.wallet.Visible = mode == "lobby" or mode == "results" or mode == "intro" or mode == "spectate"
	E.garageBtn.Visible = mode == "lobby" or mode == "results" or mode == "spectate"
	if not E.garageBtn.Visible then
		Hud.openGarage(false)
	end
	E.results.Visible = mode == "results"
	E.banner.Visible = mode == "lobby" or mode == "intro" or mode == "spectate"
	if mode ~= "countdown" and mode ~= "race" then
		E.big.Text = ""
	end
end

function Hud.banner(title: string, sub: string)
	E.bannerTitle.Text = title
	E.bannerSub.Text = sub
end

function Hud.big(text: string, color: Color3?, dur: number?)
	E.big.Text = text
	E.big.TextStrokeColor3 = color or PINK
	E.big.TextTransparency = 0
	E.big.TextStrokeTransparency = 0
	local token = {}
	E.bigToken = token
	task.delay(dur or 0.9, function()
		if E.bigToken == token then
			TweenService:Create(E.big, TweenInfo.new(0.25), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function Hud.callout(text: string, color: Color3?, dur: number?)
	local l = label({
		Size = UDim2.fromOffset(520, 36),
		Text = text,
		TextColor3 = WHITE,
		TextStrokeColor3 = color or PINK,
		TextStrokeTransparency = 0,
		Parent = E.callouts,
	})
	local kids = E.callouts:GetChildren()
	if #kids > 4 then
		for _, k in kids do
			if k:IsA("TextLabel") then
				k:Destroy()
				break
			end
		end
	end
	task.delay(dur or 1.6, function()
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.wait(0.32)
			l:Destroy()
		end
	end)
end

local function fmtTime(t: number?): string
	if not t then
		return "—"
	end
	local m = math.floor(t / 60)
	local s = t - m * 60
	return string.format("%d:%05.2f", m, s)
end
Hud.fmtTime = fmtTime

--- st: { place, total, lap, laps, speed (м/с), meter, coins, item, roulette, draft, time, wrongWay, order = {{name, me, color}} }
function Hud.race(st)
	E.place.Text = tostring(st.place)
	E.placeOf.Text = "/" .. tostring(st.total)
	E.lap.Text = if st.finished then "ФИНИШ!" else string.format("КРУГ %d/%d", math.clamp(st.lap, 1, st.laps), st.laps)
	E.time.Text = fmtTime(st.time)
	E.speed.Text = tostring(math.floor(math.abs(st.speed) * 3.6 + 0.5))
	for i, s in E.meterSegs do
		local f = math.clamp(st.meter - (i - 1), 0, 1)
		s.fill.Size = UDim2.fromScale(f, 1)
		s.fill.BackgroundTransparency = if f >= 1 then 0 else 0.35
	end
	E.coins.Text = "● " .. tostring(st.coins) .. (if st.coins >= 10 then " MAX" else "")
	-- предмет
	if st.roulette and st.roulette > 0 then
		local ids = Layout.ITEM_IDS
		local k = ids[(math.floor(os.clock() * 14) % #ids) + 1]
		E.itemIcon.Text = Layout.ITEMS[k].icon
		E.itemName.Text = ""
	elseif st.item then
		E.itemIcon.Text = Layout.ITEMS[st.item].icon
		E.itemName.Text = Layout.ITEMS[st.item].name
	else
		E.itemIcon.Text = ""
		E.itemName.Text = ""
	end
	E.draftBar.Visible = st.draft > 0.05
	E.draftFill.Size = UDim2.fromScale(math.clamp(st.draft / Kart.PHYS.draftTime, 0, 1), 1)
	for i, r in E.boardRows do
		local o = st.order[i]
		r.row.Visible = o ~= nil
		if o then
			r.name.Text = o.name
			r.row.BackgroundColor3 = if o.me then PINK else DARK
			r.row.BackgroundTransparency = if o.me then 0.1 else 0.45
			r.num.TextColor3 = o.color or WHITE
		end
	end
end

function Hud.rev(rev: number, charge: number, visible: boolean)
	E.rev.Visible = visible
	E.revNeedle.Position = UDim2.new(math.clamp(rev, 0, 1), -3, 0, -3)
	E.revCharge.Size = UDim2.new(math.clamp(charge, 0, 1), 0, 0, 5)
end

--- data: { list = {{id,name,charId,place,time,finished,gain,total,isBot}}, final, standings, raceNum, raceCount }
function Hud.showResults(data, myId: number, myKey: string?)
	for _, c in E.resList:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	if data.final then
		E.resTitle.Text = "ИТОГ ГРАН-ПРИ"
		for i, st in data.standings do
			if i > 8 then
				break
			end
			local me = st.key == myKey
			local row = panel({
				Size = UDim2.new(1, 0, 0, 31),
				LayoutOrder = i,
				BackgroundColor3 = if me then PINK else Color3.fromRGB(50, 40, 80),
				BackgroundTransparency = 0.15,
				Parent = E.resList,
			})
			label({
				Size = UDim2.fromOffset(40, 27),
				Position = UDim2.fromOffset(6, 2),
				Font = NUM,
				Text = tostring(i),
				TextColor3 = if i <= 3 then GOLD else WHITE,
				Parent = row,
			})
			label({
				Size = UDim2.new(1, -170, 0, 25),
				Position = UDim2.fromOffset(52, 3),
				Font = TXT2,
				Text = st.name,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			label({
				Size = UDim2.fromOffset(100, 25),
				Position = UDim2.new(1, -110, 0, 3),
				Font = NUM,
				Text = tostring(st.total) .. " оч.",
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
		end
	else
		E.resTitle.Text = string.format("ГОНКА %d/%d — ИТОГИ", data.raceNum, data.raceCount)
		for _, r in data.list do
			local me = r.id == myId
			local row = panel({
				Size = UDim2.new(1, 0, 0, 31),
				LayoutOrder = r.place,
				BackgroundColor3 = if me then PINK else Color3.fromRGB(50, 40, 80),
				BackgroundTransparency = 0.15,
				Parent = E.resList,
			})
			label({
				Size = UDim2.fromOffset(40, 27),
				Position = UDim2.fromOffset(6, 2),
				Font = NUM,
				Text = tostring(r.place),
				TextColor3 = if r.place <= 3 then GOLD else WHITE,
				Parent = row,
			})
			local c = charById[r.charId]
			new(
				"Frame",
				{
					Size = UDim2.fromOffset(8, 22),
					Position = UDim2.fromOffset(46, 4),
					BackgroundColor3 = if c then Color3.fromHex(c.kart) else WHITE,
					BorderSizePixel = 0,
					Parent = row,
				},
				{ corner(3) }
			)
			label({
				Size = UDim2.new(1, -300, 0, 25),
				Position = UDim2.fromOffset(62, 3),
				Font = TXT2,
				Text = r.name .. (if r.isBot then "" else " ★"),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			label({
				Size = UDim2.fromOffset(110, 25),
				Position = UDim2.new(1, -230, 0, 3),
				Font = NUM,
				Text = if r.finished then fmtTime(r.time) else "—",
				Parent = row,
			})
			label({
				Size = UDim2.fromOffset(110, 25),
				Position = UDim2.new(1, -116, 0, 3),
				Font = NUM,
				Text = string.format("+%d (%d)", r.gain, r.total),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
		end
	end
	E.resReward.Text = ""
	E.resNext.Text = if data.final
		then "Новый Гран-при скоро начнётся"
		else "Следующая трасса через несколько секунд…"
end

function Hud.showReward(rw)
	local parts = { string.format("Собрано монет: %d", rw.collected), string.format("За место: +%d", rw.placeBonus) }
	if rw.cupBonus and rw.cupBonus > 0 then
		table.insert(parts, string.format("Кубок (%d место): +%d", rw.cupPlace, rw.cupBonus))
	end
	E.resReward.Text = table.concat(parts, "   ·   ") .. string.format("   =  ● %d", rw.total)
end

return Hud
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Input</string>
          <string name="Source"><![CDATA[--!strict
-- Управление: клавиатура (как в веб-версии), геймпад и сенсорные кнопки (их рисует Hud).
--   ←/→ или A/D — руль, ↑/W — газ, ↓/S — тормоз/назад, Пробел/Shift — дрифт и трюк,
--   E/Q/Enter — предмет, F/X — буст из шкалы.
--   Геймпад: стик/крестовина — руль, R2 — газ, L2 — тормоз, R1/X — дрифт, L1 — предмет, Y — буст.
local UserInputService = game:GetService("UserInputService")

local Input = {}

local KEYS = {
	left = { Enum.KeyCode.Left, Enum.KeyCode.A },
	right = { Enum.KeyCode.Right, Enum.KeyCode.D },
	up = { Enum.KeyCode.Up, Enum.KeyCode.W },
	down = { Enum.KeyCode.Down, Enum.KeyCode.S },
	drift = { Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonX },
	item = { Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Return, Enum.KeyCode.ButtonL1 },
	boost = { Enum.KeyCode.F, Enum.KeyCode.X, Enum.KeyCode.ButtonY },
}

local edges = { drift = false, item = false, boost = false }
local touch = { steer = 0, gas = false, brake = false, drift = false }
Input.touch = touch

local function anyDown(list: { Enum.KeyCode }): boolean
	for _, k in list do
		local isPad = string.sub(k.Name, 1, 6) == "Button"
		if isPad then
			if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, k) then
				return true
			end
		elseif UserInputService:IsKeyDown(k) then
			return true
		end
	end
	return false
end

UserInputService.InputBegan:Connect(function(io: InputObject, processed: boolean)
	if processed and io.UserInputType == Enum.UserInputType.Keyboard and UserInputService:GetFocusedTextBox() then
		return
	end
	for name, list in KEYS do
		if edges[name] ~= nil and table.find(list, io.KeyCode) then
			edges[name] = true
		end
	end
end)

--- Сенсорные кнопки сообщают нажатия сюда.
function Input.press(name: string)
	if edges[name] ~= nil then
		edges[name] = true
	end
end

local pad = { steer = 0, gas = 0, brake = 0 }
UserInputService.InputChanged:Connect(function(io: InputObject)
	if io.KeyCode == Enum.KeyCode.Thumbstick1 then
		local x = io.Position.X
		pad.steer = if math.abs(x) > 0.15 then x else 0
	elseif io.KeyCode == Enum.KeyCode.ButtonR2 then
		pad.gas = io.Position.Z
	elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
		pad.brake = io.Position.Z
	end
end)
UserInputService.InputEnded:Connect(function(io: InputObject)
	if io.KeyCode == Enum.KeyCode.ButtonR2 then
		pad.gas = 0
	elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
		pad.brake = 0
	elseif io.KeyCode == Enum.KeyCode.Thumbstick1 then
		pad.steer = 0
	end
end)

--- Снять состояние за кадр: { steer, throttle, brake, driftHeld, driftPressed, item, boost }.
function Input.read()
	if UserInputService:GetFocusedTextBox() then
		edges.drift, edges.item, edges.boost = false, false, false
		return { steer = 0, throttle = 0, brake = 0, driftHeld = false, driftPressed = false, item = false, boost = false }
	end
	local steer = 0
	if anyDown(KEYS.left) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.DPadLeft) then
		steer -= 1
	end
	if anyDown(KEYS.right) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.DPadRight) then
		steer += 1
	end
	if steer == 0 then
		steer = if pad.steer ~= 0 then pad.steer else touch.steer
	end
	local throttle = if anyDown(KEYS.up) or touch.gas then 1 else 0
	throttle = math.max(throttle, pad.gas)
	local brake = if anyDown(KEYS.down) or touch.brake then 1 else 0
	brake = math.max(brake, pad.brake)
	local out = {
		steer = math.clamp(steer, -1, 1),
		throttle = throttle,
		brake = brake,
		driftHeld = anyDown(KEYS.drift) or touch.drift,
		driftPressed = edges.drift,
		item = edges.item,
		boost = edges.boost,
	}
	edges.drift, edges.item, edges.boost = false, false, false
	return out
end

return Input
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">KartModel</string>
          <string name="Source"><![CDATA[--!strict
-- Модель карта с пилотом в аниме-стиле из простых деталей (цвета гонщика из Shared/Characters).
-- Корень якорный, остальные детали приварены — двигаем одну деталь за кадр.
-- Эффекты: искры дрифта по уровню, пламя буста, щит, лёд, кручение после попадания, табличка с именем.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local SC = Config.SCALE
local KartModel = {}
KartModel.__index = KartModel

local DRIFT_COLORS = {
	[0] = Color3.fromRGB(255, 255, 255),
	[1] = Color3.fromRGB(85, 184, 255),
	[2] = Color3.fromRGB(255, 165, 58),
	[3] = Color3.fromRGB(255, 85, 224),
}
KartModel.DRIFT_COLORS = DRIFT_COLORS

local BOOST_COLORS = {
	pad = Color3.fromRGB(57, 243, 255),
	boost1 = Color3.fromRGB(85, 184, 255),
	boost2 = Color3.fromRGB(255, 165, 58),
	boost3 = Color3.fromRGB(255, 85, 224),
	item = Color3.fromRGB(255, 120, 40),
	draft = Color3.fromRGB(180, 240, 255),
	rocket = Color3.fromRGB(255, 220, 80),
	trick = Color3.fromRGB(120, 255, 170),
}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

function KartModel.new(char, name: string?, isMe: boolean?)
	local self = setmetatable({}, KartModel)
	local model = Instance.new("Model")
	model.Name = "Kart_" .. (name or char.name)
	self.model = model

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.Size = Vector3.new(1, 1, 1)
	root.Parent = model
	model.PrimaryPart = root
	self.root = root

	local kartC = hex(char.kart)
	local accC = hex(char.kartAccent)
	local trimC = hex(char.trim)

	-- локальные координаты в метрах: X вправо, Y вверх, −Z вперёд (как LookVector)
	local function add(shape: Enum.PartType?, size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material?, rot: CFrame?, cls: string?): BasePart
		local p: BasePart
		if cls == "Wedge" then
			p = Instance.new("WedgePart")
		else
			local pp = Instance.new("Part")
			if shape then
				pp.Shape = shape
			end
			p = pp
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Material = mat or Enum.Material.SmoothPlastic
		p.Size = size * SC
		p.Color = color
		p.CFrame = root.CFrame * CFrame.new(pos * SC) * (rot or CFrame.identity)
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		p.Parent = model
		return p
	end

	-- шасси и корпус
	add(nil, Vector3.new(1.7, 0.28, 2.5), Vector3.new(0, 0.42, 0), Color3.fromRGB(40, 40, 52))
	add(nil, Vector3.new(1.5, 0.42, 1.6), Vector3.new(0, 0.72, 0.15), kartC)
	add(nil, Vector3.new(1.3, 0.38, 0.9), Vector3.new(0, 0.68, -1.05), kartC, nil, nil, "Wedge")
	add(nil, Vector3.new(1.55, 0.14, 0.35), Vector3.new(0, 0.5, -1.45), accC) -- бампер
	add(nil, Vector3.new(1.62, 0.1, 1.7), Vector3.new(0, 0.95, 0.15), trimC) -- кант
	add(nil, Vector3.new(1.8, 0.1, 0.4), Vector3.new(0, 1.35, 1.25), accC) -- спойлер
	add(nil, Vector3.new(0.1, 0.4, 0.1), Vector3.new(-0.6, 1.15, 1.2), Color3.fromRGB(40, 40, 52))
	add(nil, Vector3.new(0.1, 0.4, 0.1), Vector3.new(0.6, 1.15, 1.2), Color3.fromRGB(40, 40, 52))
	-- колёса
	local wheels = {}
	for _, w in { { -0.85, -0.85 }, { 0.85, -0.85 }, { -0.88, 0.9 }, { 0.88, 0.9 } } do
		local big = w[2] > 0
		local r = if big then 0.42 else 0.36
		table.insert(
			wheels,
			add(Enum.PartType.Cylinder, Vector3.new(if big then 0.42 else 0.34, r * 2, r * 2), Vector3.new(w[1], r, w[2]), Color3.fromRGB(30, 30, 36))
		)
		add(
			Enum.PartType.Cylinder,
			Vector3.new(0.05, r * 1.1, r * 1.1),
			Vector3.new(w[1] + (if w[1] > 0 then 1 else -1) * (if big then 0.22 else 0.18), r, w[2]),
			trimC,
			Enum.Material.Metal
		)
	end
	-- выхлоп
	local exL = add(
		Enum.PartType.Cylinder,
		Vector3.new(0.35, 0.18, 0.18),
		Vector3.new(-0.35, 0.62, 1.35),
		Color3.fromRGB(150, 150, 160),
		Enum.Material.Metal,
		CFrame.Angles(0, math.pi / 2, 0)
	)
	add(
		Enum.PartType.Cylinder,
		Vector3.new(0.35, 0.18, 0.18),
		Vector3.new(0.35, 0.62, 1.35),
		Color3.fromRGB(150, 150, 160),
		Enum.Material.Metal,
		CFrame.Angles(0, math.pi / 2, 0)
	)

	-- пилот
	local skin = hex(char.skin)
	local hair = hex(char.hair)
	add(nil, Vector3.new(0.75, 0.6, 0.5), Vector3.new(0, 1.2, 0.35), hex(char.outfit)) -- торс
	add(nil, Vector3.new(0.77, 0.12, 0.52), Vector3.new(0, 1.05, 0.35), hex(char.outfitAccent))
	add(Enum.PartType.Ball, Vector3.new(0.78, 0.78, 0.78), Vector3.new(0, 1.82, 0.3), skin) -- голова
	add(Enum.PartType.Ball, Vector3.new(0.9, 0.86, 0.9), Vector3.new(0, 1.92, 0.42), hair, Enum.Material.SmoothPlastic) -- волосы
	add(nil, Vector3.new(0.86, 0.22, 0.3), Vector3.new(0, 2.12, 0.02), hair) -- чёлка
	add(Enum.PartType.Ball, Vector3.new(0.34, 0.5, 0.34), Vector3.new(-0.42, 1.7, 0.55), hair) -- хвостики
	add(Enum.PartType.Ball, Vector3.new(0.34, 0.5, 0.34), Vector3.new(0.42, 1.7, 0.55), hair)
	add(nil, Vector3.new(0.12, 0.2, 0.04), Vector3.new(-0.15, 1.84, -0.09), Color3.fromRGB(40, 30, 60)) -- глаза
	add(nil, Vector3.new(0.12, 0.2, 0.04), Vector3.new(0.15, 1.84, -0.09), Color3.fromRGB(40, 30, 60))
	add(nil, Vector3.new(0.05, 0.06, 0.045), Vector3.new(-0.13, 1.9, -0.1), Color3.new(1, 1, 1), Enum.Material.Neon)
	add(nil, Vector3.new(0.05, 0.06, 0.045), Vector3.new(0.17, 1.9, -0.1), Color3.new(1, 1, 1), Enum.Material.Neon)
	-- руль
	add(
		Enum.PartType.Cylinder,
		Vector3.new(0.06, 0.5, 0.5),
		Vector3.new(0, 1.18, -0.25),
		Color3.fromRGB(40, 40, 52),
		nil,
		CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, -0.5)
	)

	-- эффекты
	local flame = add(Enum.PartType.Ball, Vector3.new(0.4, 0.4, 1.2), Vector3.new(0, 0.62, 1.9), Color3.fromRGB(255, 160, 60), Enum.Material.Neon)
	flame.CastShadow = false
	flame.Transparency = 1
	self.flame = flame
	local shield = add(Enum.PartType.Ball, Vector3.new(4.1, 4.1, 4.1), Vector3.new(0, 1.0, 0), Color3.fromRGB(73, 216, 255), Enum.Material.ForceField)
	shield.CastShadow = false
	shield.Transparency = 1
	self.shield = shield
	local ice = add(nil, Vector3.new(2.6, 2.4, 3.3), Vector3.new(0, 1.0, 0), Color3.fromRGB(159, 232, 255), Enum.Material.Ice)
	ice.CastShadow = false
	ice.Transparency = 1
	self.ice = ice

	-- искры дрифта у задних колёс
	local sparks = {}
	for _, x in { -0.9, 0.9 } do
		local att = Instance.new("Attachment")
		att.Position = Vector3.new(x, 0.1, 1.0) * SC
		att.Parent = root
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Rate = 0
		pe.Lifetime = NumberRange.new(0.2, 0.4)
		pe.Speed = NumberRange.new(6, 14)
		pe.SpreadAngle = Vector2.new(35, 35)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) })
		pe.LightEmission = 1
		pe.Acceleration = Vector3.new(0, -30, 0)
		pe.EmissionDirection = Enum.NormalId.Back
		pe.Parent = att
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Rate = 0
		smoke.Lifetime = NumberRange.new(0.4, 0.8)
		smoke.Speed = NumberRange.new(1, 3)
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		smoke.Color = ColorSequence.new(Color3.fromRGB(232, 228, 240))
		smoke.Parent = att
		table.insert(sparks, { pe = pe, smoke = smoke })
	end
	self.sparks = sparks
	self.exhaust = exL

	-- табличка с именем
	if not isMe then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(160, 34)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 3.2 * SC, 0)
		bb.AlwaysOnTop = false
		bb.MaxDistance = 250
		bb.LightInfluence = 0
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = name or char.name
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.TextStrokeColor3 = kartC
		tl.TextStrokeTransparency = 0
		tl.Parent = bb
		bb.Parent = root
		self.tag = tl
	end

	self.wheels = wheels
	self.spin = 0
	self.wheelRot = 0
	return self
end

function KartModel:setParent(p: Instance?)
	self.model.Parent = p
end

function KartModel:destroy()
	self.model:Destroy()
end

--- s: { pos (м), heading, moveHeading, surfaceUp, speed, airborne, drifting, driftDir, driftLevel,
---      boostKind, shield, frozen, spinning, trick, hop }
function KartModel:update(dt: number, s)
	local up: Vector3 = s.surfaceUp or Vector3.yAxis
	local h = s.heading
	if s.spinning then
		self.spin += dt * 13
	else
		self.spin = 0
	end
	h += self.spin
	local fwd = Vector3.new(math.sin(h), 0, math.cos(h))
	local right = fwd:Cross(up)
	if right.Magnitude < 1e-3 then
		right = Vector3.xAxis
	end
	right = right.Unit
	fwd = up:Cross(right).Unit
	local back = right:Cross(up)
	local cf = CFrame.fromMatrix(s.pos * SC, right, up, back)
	if s.trick then
		self.trickT = (self.trickT or 0) + dt
		cf *= CFrame.Angles(-math.min(1, self.trickT / 0.45) * math.pi * 2, 0, 0)
	else
		self.trickT = 0
	end
	-- крен в заносе
	if s.drifting then
		cf *= CFrame.Angles(0, 0, -0.08 * (s.driftDir or 0))
	end
	self.root.CFrame = cf

	-- эффекты
	local bk = s.boostKind or ""
	if bk ~= "" then
		self.flame.Transparency = 0.1 + math.random() * 0.25
		self.flame.Color = BOOST_COLORS[bk] or Color3.fromRGB(255, 160, 60)
	else
		self.flame.Transparency = 1
	end
	self.shield.Transparency = if s.shield then 0.25 else 1
	self.ice.Transparency = if s.frozen then 0.35 else 1
	local lvl = if s.drifting then (s.driftLevel or 0) else -1
	for _, sp in self.sparks do
		if lvl >= 1 and not s.airborne then
			sp.pe.Rate = 40 + lvl * 25
			sp.pe.Color = ColorSequence.new(DRIFT_COLORS[lvl])
		else
			sp.pe.Rate = 0
		end
		sp.smoke.Rate = if lvl >= 0 and not s.airborne then 18 else 0
	end
end

return KartModel
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--!strict
-- Клиент «Sakura Drift»: свой карт считается здесь (Shared/Kart — та же физика, что в веб-версии),
-- соперники — по снимкам сервера с плавным сглаживанием. Камера, HUD, звук и подбор монет/кристаллов.
local Players = game:GetService("Players")
local function stage(name: string)
	Players.LocalPlayer:SetAttribute("SakuraStage", name)
end
stage("общие модули")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Tracks = require(Shared.Tracks)
local Kart = require(Shared.Kart)
local Bot = require(Shared.Bot)
local Net = require(Shared.Net)
local Characters = require(Shared.Characters)

stage("модули клиента")
local Input = require(script.Parent.Input)
local Hud = require(script.Parent.Hud)
local World = require(script.Parent.World)
local KartModel = require(script.Parent.KartModel)
local Audio = require(script.Parent.Audio)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local SC = Config.SCALE

stage("ждём сервер (ремоуты)")
local RE_State = Net.get("KartState") :: UnreliableRemoteEvent
local RE_Snap = Net.get("Snapshot") :: UnreliableRemoteEvent
local RE_Race = Net.get("Race") :: RemoteEvent
local RE_Action = Net.get("Action") :: RemoteEvent
local RF_Shop = Net.get("Shop") :: RemoteFunction

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local CHAR_BY_ID = {}
for _, c in Characters do
	CHAR_BY_ID[c.id] = c
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- ---------------------------------------------------------------- состояние

local R: any = nil -- текущая гонка (после "setup")
local profile: any = nil
local myKey = "p" .. player.UserId

local function clearRace()
	if not R then
		return
	end
	for _, rk in R.remote do
		rk.model:destroy()
	end
	if R.myModel then
		R.myModel:destroy()
	end
	for _, o in R.orbs do
		o:Destroy()
	end
	World.clearTraps()
	Audio.stopEngine()
	R = nil
end

local function setupRace(d)
	clearRace()
	local track = Tracks.get(d.trackId)
	local built = World.build(d.trackId)
	World.clearTraps()
	for _, b in built.boxes do
		b.active = true
		b.timer = 0
	end
	for _, c in built.coins do
		c.t = 0
	end
	for _, e in d.boxes or {} do
		World.setBoxTaken(e[1], e[2])
	end
	for _, e in d.coins or {} do
		World.setCoinTaken(e[1], e[2])
	end
	for _, t in d.traps or {} do
		World.addTrap(t.id, t.x, t.y, t.z, t.s, t.lat)
	end
	local r = {
		track = track,
		trackId = d.trackId,
		laps = d.laps,
		raceNum = d.raceNum,
		raceCount = d.raceCount,
		myId = d.myId,
		roster = {},
		remote = {},
		orbs = {},
		finishPlace = {},
		kart = nil,
		myModel = nil,
		item = nil,
		roulette = 0,
		launched = false,
		finished = false,
		autopilot = nil,
		lastStage = 0,
		sendAcc = 0,
		camHeading = nil,
		camPos = nil,
		lastPlace = 0,
		raceStart = d.raceStart or 0,
		wrongWay = false,
	}
	for _, e in d.roster do
		r.roster[e.id] = e
		local c = CHAR_BY_ID[e.charId] or Characters[1]
		if e.id ~= d.myId then
			local m = KartModel.new(c, e.name, false)
			m:setParent(built.folder)
			r.remote[e.id] = { model = m, net = nil, disp = nil, heading = 0, recv = 0, hint = -1, up = Vector3.yAxis, roster = e }
		end
	end
	if d.myId > 0 then
		local me = r.roster[d.myId]
		local c = CHAR_BY_ID[me.charId] or Characters[1]
		local k = Kart.new(track, { stats = c.stats, isPlayer = true })
		local L = track.length
		local slot = d.myId - 1
		local row, col = math.floor(slot / 2), slot % 2
		local fr0 = track:frameAtProgress(L - 8)
		k:placeAt(L - 8 - row * 6.5 - col * 3, (if col == 0 then -1 else 1) * fr0.hw * 0.42)
		k.lapsDone = -1
		k.totalProgress = -L + k.progress
		k.onGrid = true
		r.kart = k
		r.myModel = KartModel.new(c, me.name, true)
		r.myModel:setParent(built.folder)
		if d.phase == "race" then
			-- подключились посреди гонки (переподключение) — сразу в путь
			k:launch()
			r.launched = true
		end
	end
	R = r
	World.setLights(0)
	Audio.playMusic(track.data.music)
	Audio.setMusicSpeed(1)
	if r.kart then
		Audio.startEngine()
	end
end

-- ---------------------------------------------------------------- сеть

RE_Snap.OnClientEvent:Connect(function(b: buffer)
	if not R then
		return
	end
	local t, karts, orbs = Net.unpackSnapshot(b)
	local recv = now()
	for _, s in karts do
		local rk = R.remote[s.id]
		if rk then
			if not rk.net or t >= (rk.netT or 0) then
				rk.net = s
				rk.netT = t
				rk.recv = recv
			end
		end
	end
	-- сферы
	local seen = {}
	for _, o in orbs do
		seen[o.id] = true
		local p = R.orbs[o.id]
		if not p then
			p = Instance.new("Part")
			p.Shape = Enum.PartType.Ball
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(255, 122, 230)
			p.Size = Vector3.one * 1.1 * SC
			local light = Instance.new("PointLight")
			light.Color = p.Color
			light.Range = 18
			light.Brightness = 3
			light.Parent = p
			p.Parent = workspace
			R.orbs[o.id] = p
		end
		p:SetAttribute("tx", o.x)
		p:SetAttribute("ty", o.y)
		p:SetAttribute("tz", o.z)
	end
	for id, p in R.orbs do
		if not seen[id] then
			p:Destroy()
			R.orbs[id] = nil
		end
	end
end)

local LAUNCH_TEXT = {
	perfect = { "ИДЕАЛЬНЫЙ СТАРТ!", Color3.fromRGB(60, 255, 120) },
	good = { "ХОРОШИЙ СТАРТ", Color3.fromRGB(80, 200, 110) },
	spin = { "ПЕРЕГАЗОВКА!", Color3.fromRGB(255, 60, 70) },
}

local function onRace(kind: string, d: any)
	if kind == "profile" then
		profile = d
		Hud.setProfile(d)
	elseif kind == "setup" then
		setupRace(d)
	elseif kind == "lobby" then
		clearRace()
	elseif not R then
		return
	elseif kind == "go" then
		R.raceStart = d.raceStart
	elseif kind == "roulette" then
		R.roulette = d.time
		R.pendingItem = d.item
		Audio.sfx("roulette", 0.7)
	elseif kind == "item" then
		R.roulette = 0
		R.item = d.item
		Audio.sfx("itemGet", 0.8)
	elseif kind == "boost" and R.kart then
		R.kart:addBoost(d.time, d.power, d.kind)
		Audio.sfx("boost", 1)
	elseif kind == "shield" and R.kart then
		R.kart.shieldTimer = d.time
		Audio.sfx("shieldUp", 0.9)
	elseif kind == "hit" and R.kart then
		if R.kart:hit(d.kind) then
			Hud.callout(if d.kind == "freeze" then "ЗАМОРОЗКА!" else "ПОПАДАНИЕ!", Color3.fromRGB(255, 80, 120))
		end
	elseif kind == "hitFx" then
		if d.by == R.myId and d.id ~= R.myId then
			local who = R.roster[d.id]
			Hud.callout("Попал в " .. (if who then who.name else "соперника") .. "!", Color3.fromRGB(160, 90, 255))
		end
	elseif kind == "boxTaken" then
		World.setBoxTaken(d.i)
	elseif kind == "coinTaken" then
		if d.by ~= R.myId then
			World.setCoinTaken(d.i)
		end
	elseif kind == "trapAdd" then
		World.addTrap(d.id, d.x, d.y, d.z, d.s, d.lat)
		if d.by == R.myId then
			Audio.sfx("trapDrop", 0.8)
		end
	elseif kind == "trapRemove" then
		World.removeTrap(d.id)
		if d.burst then
			Audio.sfx("shatter", 0.5)
		end
	elseif kind == "orbFire" then
		Audio.sfx("orbFire", if d.id == R.myId then 0.9 else 0.4)
	elseif kind == "orbEnd" then
		Audio.sfx("hit", 0.5)
	elseif kind == "finish" then
		R.finishPlace[d.id] = d.place
		local who = R.roster[d.id]
		if d.id == R.myId then
			R.myFinishTime = d.time
			Hud.big(string.format("ФИНИШ — %d МЕСТО!", d.place), if d.place <= 3 then Color3.fromRGB(255, 200, 40) else nil, 2.5)
			Audio.sfx(if d.place <= 3 then "finishWin" else "finishLose", 1)
		elseif who then
			Hud.callout(string.format("%s финишировал%s %d-м", who.name, "", d.place), Color3.fromRGB(90, 80, 130), 1.4)
		end
	elseif kind == "results" then
		Hud.showResults(d, R.myId, myKey)
		Audio.playMusic("results")
		Audio.setMusicSpeed(1)
		Audio.stopEngine()
	elseif kind == "reward" then
		Hud.showReward(d)
	elseif kind == "leave" then
		local rk = R.remote[d.id]
		if rk then
			rk.model:destroy()
			R.remote[d.id] = nil
		end
	end
end
RE_Race.OnClientEvent:Connect(onRace)

-- ---------------------------------------------------------------- гонка: свой карт

local function sendState()
	if not R or not R.kart then
		return
	end
	local b = buffer.create(Net.KART_BYTES)
	Net.writeKart(b, 0, Net.fromKart(R.myId, R.kart))
	RE_State:FireServer(b)
end

local function remoteVel(s): (number, number)
	return math.sin(s.moveHeading) * s.speed, math.cos(s.moveHeading) * s.speed
end

local BOOST_TEXT = { "МИНИ-ТУРБО!", "СУПЕР-ТУРБО!", "УЛЬТРА-ТУРБО!" }

local function handleKartEvents(k)
	for _, e in k.events do
		Audio.kartEvent(e)
		local t = e.type
		if t == "boostFire" then
			Hud.callout(BOOST_TEXT[e.level] or "ТУРБО!", KartModel.DRIFT_COLORS[e.level])
		elseif t == "slipstream" then
			Hud.callout("СЛИПСТРИМ!", Color3.fromRGB(150, 230, 255))
		elseif t == "trickBoost" then
			Hud.callout("ТРЮК!", Color3.fromRGB(120, 255, 170))
		elseif t == "coinLoss" then
			Hud.callout(string.format("−%d монеты", e.n), Color3.fromRGB(255, 160, 40))
		elseif t == "shieldBreak" then
			Hud.callout("БАРЬЕР СПАС!", Color3.fromRGB(73, 216, 255))
		elseif t == "wrongWay" then
			R.wrongWay = e.on
		elseif t == "launch" then
			local lt = LAUNCH_TEXT[e.result]
			if lt then
				Hud.callout(lt[1], lt[2], 1.8)
			end
		elseif t == "lapCross" and e.forward and R.launched and not R.finished then
			if k.lapsDone >= R.laps then
				R.finished = true
				k.finished = true
				R.autopilot = Bot.new(k, Bot.DIFFICULTY.hard, function()
					return math.random()
				end)
				Audio.setMusicSpeed(1)
			elseif k.lapsDone >= 1 then
				if k.lapsDone == R.laps - 1 then
					Hud.big("ФИНАЛЬНЫЙ КРУГ!", Color3.fromRGB(255, 80, 120), 1.6)
					Audio.sfx("finalLap", 1)
					local fk = R.track.data.music .. "_final"
					if (Config.Sounds.music :: any)[fk] and (Config.Sounds.music :: any)[fk] ~= "" then
						Audio.playMusic(fk)
					else
						Audio.setMusicSpeed(1.06)
					end
				else
					Hud.callout(string.format("КРУГ %d/%d", k.lapsDone + 1, R.laps), Color3.fromRGB(57, 243, 255))
					Audio.sfx("lap", 0.9)
				end
			end
		end
	end
	table.clear(k.events)
end

local function pickups(k)
	local w = World.current()
	if not w then
		return
	end
	local p = k.pos
	for i, b in w.boxes do
		if b.active then
			local dx, dz, dy = p.X - b.pos.X, p.Z - b.pos.Z, p.Y + 0.8 - b.pos.Y
			if dx * dx + dz * dz < 2.3 * 2.3 and math.abs(dy) < 2.4 then
				World.setBoxTaken(i)
				RE_Action:FireServer("box", i)
				Audio.sfx("itemBox", 0.8)
			end
		end
	end
	for i, c in w.coins do
		if c.t <= 0 then
			local dx, dz = p.X - c.pos.X, p.Z - c.pos.Z
			if dx * dx + dz * dz <= 1.75 * 1.75 and math.abs(p.Y + 0.9 - c.pos.Y) <= 2.2 then
				World.setCoinTaken(i)
				k:addCoin()
				RE_Action:FireServer("coin", i)
			end
		end
	end
	for id, t in w.traps do
		if t.age >= 0.35 and not k.airborne then
			local dx, dz, dy = p.X - t.pos.X, p.Z - t.pos.Z, p.Y - t.pos.Y
			if dx * dx + dz * dz < 1.7 * 1.7 and math.abs(dy) < 1.6 then
				World.removeTrap(id)
				RE_Action:FireServer("trap", id)
				if k:hit("freeze") then
					Hud.callout("ЗАМОРОЗКА!", Color3.fromRGB(120, 200, 255))
				end
			end
		end
	end
end

local SUBSTEP = 1 / 120

local function stepMyKart(dt: number, phase: string, t: number, inp)
	local k = R.kart
	if phase == "countdown" then
		local stage = math.min(4, math.floor(t / (Config.COUNT_TIME / 3)) + 1)
		if stage ~= R.lastStage then
			R.lastStage = stage
			World.setLights(stage)
			if stage <= 3 then
				Hud.big(tostring(4 - stage), nil, 0.8)
				Audio.sfx("countdown", 0.9)
			end
		end
		k:revOnGrid(dt, inp.throttle)
		handleKartEvents(k)
		return
	end
	if phase ~= "race" then
		return
	end
	if not R.launched then
		R.launched = true
		World.setLights(4)
		Hud.big("СТАРТ!", Color3.fromRGB(60, 255, 120), 1)
		Audio.sfx("go", 1)
		k:launch()
	end
	local drive
	if R.finished and R.autopilot then
		drive = R.autopilot:think(dt, { karts = { k }, order = { k }, laps = R.laps })
		drive.useItem = false
		drive.useBoost = false
	else
		drive = { steer = inp.steer, throttle = inp.throttle, brake = inp.brake, driftHeld = inp.driftHeld, driftPressed = inp.driftPressed }
		if inp.item and R.item and (R.roulette or 0) <= 0 then
			RE_Action:FireServer("use")
			R.item = nil
		end
		if inp.boost then
			k:useBoost()
		end
	end
	local steps = math.min(6, math.max(1, math.ceil(dt / SUBSTEP - 0.05)))
	local h = dt / steps
	for _ = 1, steps do
		k:step(h, drive)
		drive.driftPressed = false
		for _, rk in R.remote do
			local s = rk.net
			if s and rk.disp then
				local vx, vz = remoteVel(s)
				k:collideWith(rk.disp.X, rk.disp.Y, rk.disp.Z, vx, vz, s.shield)
			end
		end
	end
	local others = {}
	for _, rk in R.remote do
		local s = rk.net
		if s then
			table.insert(others, { progress = s.progress, lateral = s.lateral, y = rk.disp and rk.disp.Y or s.y, speed = s.speed })
		end
	end
	k:updateDraft(dt, others)
	if not R.finished then
		pickups(k)
	end
	if R.roulette > 0 then
		R.roulette -= dt
	end
	handleKartEvents(k)
end

local function updateRemotes(dt: number)
	local tnow = now()
	local track = R.track
	for _, rk in R.remote do
		local s = rk.net
		if s then
			local age = math.clamp(tnow - rk.recv, 0, 0.25)
			local vx, vz = remoteVel(s)
			local target = Vector3.new(s.x + vx * age, s.y, s.z + vz * age)
			if not rk.disp or (rk.disp - target).Magnitude > 12 then
				rk.disp = target
				rk.heading = s.heading
			else
				local a = 1 - math.exp(-dt * 14)
				rk.disp = rk.disp:Lerp(target, a)
				local dh = (s.heading - rk.heading + math.pi) % (2 * math.pi) - math.pi
				rk.heading += dh * a
			end
			local pr = track:project(rk.disp, rk.hint)
			rk.hint = pr.nearest
			rk.up = rk.up:Lerp(if s.airborne then Vector3.yAxis else pr.up, 1 - math.exp(-dt * 10)).Unit
			rk.model:update(dt, {
				pos = rk.disp,
				heading = rk.heading,
				surfaceUp = rk.up,
				airborne = s.airborne,
				drifting = s.drifting,
				driftDir = s.driftDir,
				driftLevel = s.driftLevel,
				boostKind = s.boostKind,
				shield = s.shield,
				frozen = s.frozen,
				spinning = s.spinning,
				trick = s.trick,
			})
		end
	end
	for _, p in R.orbs do
		local tx = p:GetAttribute("tx") :: number?
		if tx then
			local target = Vector3.new(tx, p:GetAttribute("ty") :: number, p:GetAttribute("tz") :: number) * SC
			p.Position = p.Position:Lerp(target, 1 - math.exp(-dt * 20))
		end
	end
end

local function myModelUpdate(dt: number)
	local k = R.kart
	if not k or not R.myModel then
		return
	end
	R.myModel:update(dt, {
		pos = k.pos,
		heading = k.heading,
		surfaceUp = k.surfaceUp,
		airborne = k.airborne,
		drifting = k.drift.active,
		driftDir = k.drift.dir,
		driftLevel = k.drift.level,
		boostKind = if k.boost.time > 0 then k.boost.kind else "",
		shield = k.shieldTimer > 0,
		frozen = k.frozenTimer > 0,
		spinning = k.spinTimer > 0 or k.launchSpin > 0,
		trick = k.trick.active,
	})
end

-- ---------------------------------------------------------------- места

local function computeOrder()
	local L = R.track.length
	local list = {}
	if R.kart then
		table.insert(list, { id = R.myId, total = R.kart.totalProgress, me = true })
	end
	for id, rk in R.remote do
		local s = rk.net
		if s then
			table.insert(list, { id = id, total = s.lapsDone * L + s.progress, me = false })
		end
	end
	table.sort(list, function(a, b)
		local fa, fb = R.finishPlace[a.id], R.finishPlace[b.id]
		if fa and fb then
			return fa < fb
		end
		if fa or fb then
			return fa ~= nil
		end
		if a.total ~= b.total then
			return a.total > b.total
		end
		return a.id < b.id
	end)
	return list
end

-- ---------------------------------------------------------------- камера

local function lerpAngle(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

local function chaseCam(dt: number, pos: Vector3, heading: number, speed: number, boosting: boolean)
	if not R.camHeading then
		R.camHeading = heading
	end
	R.camHeading = lerpAngle(R.camHeading, heading, 1 - math.exp(-dt * 6))
	local h = R.camHeading
	local fwd = Vector3.new(math.sin(h), 0, math.cos(h))
	local want = pos - fwd * 6.4 + Vector3.new(0, 2.5, 0)
	if not R.camPos or (R.camPos - want).Magnitude > 30 then
		R.camPos = want
	end
	R.camPos = R.camPos:Lerp(want, 1 - math.exp(-dt * 12))
	local look = pos + fwd * 3 + Vector3.new(0, 1.0, 0)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(R.camPos * SC, look * SC)
	local fov = 70 + math.clamp(math.abs(speed) / 40, 0, 1.4) * 10 + (if boosting then 8 else 0)
	camera.FieldOfView += (fov - camera.FieldOfView) * (1 - math.exp(-dt * 4))
end

local orbitT = 0
local function orbitCam(dt: number, center: Vector3, radius: number, height: number, speedRad: number)
	orbitT += dt * speedRad
	local p = center + Vector3.new(math.cos(orbitT) * radius, height, math.sin(orbitT) * radius)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(p * SC, center * SC)
	camera.FieldOfView = 70
end

-- ---------------------------------------------------------------- кнопки гаража

stage("интерфейс")
Hud.init({
	buy = function(id: string)
		local ok, res = pcall(function()
			return RF_Shop:InvokeServer("buy", id)
		end)
		if ok and res then
			if res.owned[id] then
				Audio.sfx("uiStart", 0.8)
			else
				Audio.sfx("uiBack", 0.8)
			end
			profile = res
			Hud.setProfile(res)
		end
	end,
	select = function(id: string)
		local ok, res = pcall(function()
			return RF_Shop:InvokeServer("select", id)
		end)
		if ok and res then
			Audio.sfx("uiSelect", 0.8)
			profile = res
			Hud.setProfile(res)
		end
	end,
})

-- фон лобби
stage("постройка трассы")
World.build(Config.TRACK_ORDER[1])
stage("ok")
Audio.playMusic("menu")
RE_Action:FireServer("hello")

-- ---------------------------------------------------------------- главный цикл

RunService.RenderStepped:Connect(function(dt: number)
	dt = math.min(dt, 0.1)
	local phase = ReplicatedStorage:GetAttribute("SD_Phase") or "lobby"
	local phaseStart = ReplicatedStorage:GetAttribute("SD_PhaseStart") or now()
	local t = now() - phaseStart
	World.update(dt)

	if phase == "lobby" or not R then
		if R then
			clearRace()
		end
		Audio.playMusic("menu")
		Hud.setMode("lobby")
		if phase == "lobby" then
			local left = math.max(0, math.ceil(Config.LOBBY_TIME - t))
			Hud.banner(
				"SAKURA DRIFT GP",
				string.format("Гран-при начнётся через %d с · выберите гонщика в гараже", left)
			)
		else
			Hud.banner("SAKURA DRIFT GP", "Подключаемся к гонке…")
		end
		local w = World.current()
		if w then
			local tr = w.track
			local c = (tr.boundsMin + tr.boundsMax) / 2
			local ext = (tr.boundsMax - tr.boundsMin).Magnitude
			orbitCam(dt, c, ext * 0.45, ext * 0.22, 0.05)
		end
		return
	end

	local inp = Input.read()
	local k = R.kart

	if k then
		stepMyKart(dt, phase, t, inp)
		myModelUpdate(dt)
		R.sendAcc += dt
		if R.sendAcc >= 1 / 20 and (phase == "intro" or phase == "countdown" or phase == "race") then
			R.sendAcc = 0
			sendState()
		end
	end
	updateRemotes(dt)

	-- место и HUD
	local order = computeOrder()
	local myPlace = 1
	local rows = {}
	for i, o in order do
		if o.me then
			myPlace = i
		end
		local e = R.roster[o.id]
		local c = e and CHAR_BY_ID[e.charId]
		table.insert(rows, { name = if e then e.name else "?", me = o.me, color = c and Color3.fromHex(c.kart) })
	end

	if phase == "intro" then
		Hud.setMode("intro")
		local d = R.track.data
		Hud.banner(d.name .. "  " .. d.jp, string.format("Гонка %d из %d · %s · %d круга", R.raceNum, R.raceCount, d.time, R.laps))
		local u = math.clamp(t / Config.INTRO_TIME, 0, 1)
		local L = R.track.length
		local e = 1 - (1 - u) ^ 2
		local camS = (L - 8) + 80 * (1 - e) - 30 * e
		local p = R.track:pointAt(camS, 12 * (1 - e), 3 + 26 * (1 - e))
		local look = R.track:pointAt(L - 22, 0, 1)
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(p * SC, look * SC)
		camera.FieldOfView = 70
		World.setLights(0)
	elseif phase == "countdown" or phase == "race" then
		if k then
			Hud.setMode(phase, { onGrid = phase == "countdown" })
			Hud.rev(k.rev, k.revCharge, phase == "countdown")
			local raceTime = if phase == "race" then (R.myFinishTime or (now() - phaseStart)) else 0
			Hud.race({
				place = myPlace,
				total = #order,
				lap = k.lapsDone + 1,
				laps = R.laps,
				speed = k.speed,
				meter = k.boostMeter,
				coins = k.coins,
				item = R.item,
				roulette = R.roulette,
				draft = k.draft,
				time = raceTime,
				finished = R.finished,
				order = rows,
			})
			if R.wrongWay and not R.finished then
				Hud.big("НЕ ТУДА!", Color3.fromRGB(255, 60, 70), 0.3)
			end
			if phase == "race" and myPlace ~= R.lastPlace and R.lastPlace > 0 and not R.finished then
				if myPlace < R.lastPlace then
					Audio.sfx("uiMove", 0.4)
				end
			end
			R.lastPlace = myPlace
			chaseCam(dt, k.pos, k:camHeading(), k.speed, k.boost.time > 0)
			Audio.updateEngine({
				dt = dt,
				rpm = k.rev,
				load = if phase == "countdown" then inp.throttle elseif k.boost.time > 0 then 1 else inp.throttle,
				limiter = k.revLimit > 0 or k.launchSpin > 0,
				drifting = k.drift.active and not k.airborne,
				driftLevel = k.drift.level,
				boosting = k.boost.time > 0,
			})
		else
			-- зритель: камера за лидером
			Hud.setMode("spectate")
			Hud.banner("ВЫ ЗРИТЕЛЬ", "Присоединитесь со следующей гонки")
			local lead = order[1]
			local rk = lead and R.remote[lead.id]
			if rk and rk.disp and rk.net then
				chaseCam(dt, rk.disp, rk.net.moveHeading, rk.net.speed, rk.net.boostKind ~= "")
			end
		end
	elseif phase == "results" then
		Hud.setMode("results")
		Audio.stopEngine()
		local focus = if k then k.pos else R.track:pointAt(0, 0, 0)
		orbitCam(dt, focus, 9, 4, 0.25)
		if k and R.finished and R.autopilot then
			-- карт докатывается сам
			local drive = R.autopilot:think(dt, { karts = { k }, order = { k }, laps = R.laps })
			drive.throttle *= 0.5
			k:step(dt, drive)
			table.clear(k.events)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Мир трассы на клиенте: дорога, бордюры, обочины, стены, бустеры, трамплины, старт с табло и светофором,
-- насыпь из Terrain, опоры мостов, декор по теме, освещение. Плюс кристаллы, монеты и ловушки.
-- Всё только визуальное (физика — в Shared/Kart), поэтому детали якорные и без коллизий.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Tracks = require(Shared.Tracks)
local Layout = require(Shared.Layout)

local SC = Config.SCALE
local World = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

-- тема окружения по трассе
local ENV = {
	sakura = {
		clock = 13.2,
		ground = Enum.Material.Grass,
		groundColor = Color3.fromRGB(126, 196, 120),
		shoulder = Color3.fromRGB(150, 205, 128),
		ambient = Color3.fromRGB(150, 130, 150),
		outdoor = Color3.fromRGB(170, 160, 185),
		haze = Color3.fromRGB(255, 220, 238),
		density = 0.28,
		bright = 2.6,
		decor = "sakura",
	},
	neon = {
		clock = 0.2,
		ground = Enum.Material.Asphalt,
		groundColor = Color3.fromRGB(28, 26, 48),
		shoulder = Color3.fromRGB(40, 36, 70),
		ambient = Color3.fromRGB(90, 70, 140),
		outdoor = Color3.fromRGB(110, 90, 170),
		haze = Color3.fromRGB(60, 30, 110),
		density = 0.35,
		bright = 1.2,
		decor = "neon",
	},
	sunset = {
		clock = 17.6,
		ground = Enum.Material.Sand,
		groundColor = Color3.fromRGB(236, 196, 140),
		shoulder = Color3.fromRGB(226, 186, 130),
		ambient = Color3.fromRGB(170, 120, 110),
		outdoor = Color3.fromRGB(200, 140, 120),
		haze = Color3.fromRGB(255, 170, 120),
		density = 0.32,
		bright = 2.2,
		decor = "sunset",
	},
	momiji = {
		clock = 15.4,
		ground = Enum.Material.LeafyGrass,
		groundColor = Color3.fromRGB(150, 140, 80),
		shoulder = Color3.fromRGB(170, 140, 80),
		ambient = Color3.fromRGB(150, 120, 100),
		outdoor = Color3.fromRGB(180, 150, 120),
		haze = Color3.fromRGB(255, 205, 160),
		density = 0.3,
		bright = 2.4,
		decor = "momiji",
	},
}

-- ---------------------------------------------------------------- детали

local root: Folder? = nil

local function part(props: { [string]: any }, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function m2s(v: Vector3): Vector3
	return v * SC
end

--- Полоса между поперечными смещениями l0..l1 от сэмпла i до сэмпла j, толщиной th (м), верх на высоте top (м над дорогой).
local function strip(track, i: number, j: number, l0: number, l1: number, top: number, th: number, color: Color3, parent: Instance, mat: Enum.Material?)
	local N = track.count
	local ia, ib = (i % N) + 1, (j % N) + 1
	local lm = (l0 + l1) / 2
	local ra, rb = track.right[ia], track.right[ib]
	local ua, ub = track.up[ia], track.up[ib]
	local a = track.pos[ia] + ra * lm + ua * (top - th / 2)
	local b = track.pos[ib] + rb * lm + ub * (top - th / 2)
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		return nil
	end
	local fwd = d / len
	local up = (ua + ub).Unit
	local right = fwd:Cross(up).Unit
	up = right:Cross(fwd).Unit
	local back = right:Cross(up)
	local mid = (a + b) / 2
	local p = part({
		Size = Vector3.new(math.abs(l1 - l0) * SC, th * SC, (len + 0.35) * SC),
		CFrame = CFrame.fromMatrix(m2s(mid), right, up, back),
		Color = color,
		Material = mat or Enum.Material.SmoothPlastic,
	}, parent)
	return p
end

-- ---------------------------------------------------------------- освещение

local function applyLighting(trackId: string)
	local env = ENV[trackId] or ENV.sakura
	Lighting.ClockTime = env.clock
	Lighting.Brightness = env.bright
	Lighting.Ambient = env.ambient
	Lighting.OutdoorAmbient = env.outdoor
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.4
	for _, c in Lighting:GetChildren() do
		if c:GetAttribute("SakuraFx") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = env.density
	atm.Haze = 1.2
	atm.Color = env.haze
	atm.Decay = env.haze:Lerp(Color3.new(1, 1, 1), 0.3)
	atm.Glare = if trackId == "sunset" then 0.6 else 0.1
	atm:SetAttribute("SakuraFx", true)
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = if trackId == "neon" then 1.1 else 0.55
	bloom.Size = 28
	bloom.Threshold = if trackId == "neon" then 0.85 else 1.6
	bloom:SetAttribute("SakuraFx", true)
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc:SetAttribute("SakuraFx", true)
	cc.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.StarCount = if trackId == "neon" then 3000 else 500
	sky:SetAttribute("SakuraFx", true)
	sky.Parent = Lighting
end

-- ---------------------------------------------------------------- декор

local function tree(parent: Instance, pos: Vector3, scale: number, trunk: Color3, leaves: { Color3 }, rnd: Random)
	local h = (4 + rnd:NextNumber() * 3) * scale
	part(
		{
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h * SC, 0.7 * scale * SC, 0.7 * scale * SC),
			CFrame = CFrame.new(m2s(pos + Vector3.new(0, h / 2, 0))) * CFrame.Angles(0, 0, math.pi / 2),
			Color = trunk,
			Material = Enum.Material.Wood,
		},
		parent
	)
	for i = 1, 3 do
		local r = (1.8 + rnd:NextNumber() * 1.2) * scale
		local off = Vector3.new((rnd:NextNumber() - 0.5) * 2.4, h + (i - 2) * 0.8 * scale, (rnd:NextNumber() - 0.5) * 2.4) * Vector3.new(scale, 1, scale)
		part(
			{
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * r * 2 * SC,
				CFrame = CFrame.new(m2s(pos + off)),
				Color = leaves[rnd:NextInteger(1, #leaves)],
				Material = Enum.Material.SmoothPlastic,
				CastShadow = true,
			},
			parent
		)
	end
end

local function palm(parent: Instance, pos: Vector3, rnd: Random)
	local h = 7 + rnd:NextNumber() * 4
	local lean = (rnd:NextNumber() - 0.5) * 0.3
	local top = pos + Vector3.new(lean * h, h, 0)
	part(
		{
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h * SC, 0.6 * SC, 0.6 * SC),
			CFrame = CFrame.lookAt(m2s((pos + top) / 2), m2s(top)) * CFrame.Angles(0, math.pi / 2, 0),
			Color = Color3.fromRGB(150, 110, 70),
			Material = Enum.Material.Wood,
		},
		parent
	)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local dir = Vector3.new(math.cos(a), -0.35, math.sin(a))
		local c = top + dir * 2
		part(
			{
				Size = Vector3.new(1.2 * SC, 0.15 * SC, 4.2 * SC),
				CFrame = CFrame.lookAt(m2s(c), m2s(c + dir)),
				Color = Color3.fromRGB(70, 170, 80),
				CastShadow = true,
			},
			parent
		)
	end
end

local NEON_COLS = { Color3.fromRGB(57, 243, 255), Color3.fromRGB(255, 80, 210), Color3.fromRGB(160, 90, 255), Color3.fromRGB(255, 200, 60) }

local function building(parent: Instance, pos: Vector3, rnd: Random)
	local w = 8 + rnd:NextNumber() * 10
	local d = 8 + rnd:NextNumber() * 10
	local h = 14 + rnd:NextNumber() * 40
	local cf = CFrame.new(m2s(pos + Vector3.new(0, h / 2, 0))) * CFrame.Angles(0, rnd:NextNumber() * math.pi, 0)
	part(
		{
			Size = Vector3.new(w, h, d) * SC,
			CFrame = cf,
			Color = Color3.fromRGB(28 + rnd:NextInteger(0, 20), 26, 50 + rnd:NextInteger(0, 30)),
			Material = Enum.Material.Glass,
			Reflectance = 0.1,
			CastShadow = true,
		},
		parent
	)
	local col = NEON_COLS[rnd:NextInteger(1, #NEON_COLS)]
	local bands = rnd:NextInteger(1, 3)
	for i = 1, bands do
		local y = -h / 2 + h * (i / (bands + 1))
		part({ Size = Vector3.new(w + 0.2, 0.4, d + 0.2) * SC, CFrame = cf * CFrame.new(0, y * SC, 0), Color = col, Material = Enum.Material.Neon }, parent)
	end
end

local function rock(parent: Instance, pos: Vector3, rnd: Random, color: Color3)
	local s = 1.5 + rnd:NextNumber() * 3
	part(
		{
			Size = Vector3.new(s * 1.4, s, s * 1.2) * SC,
			CFrame = CFrame.new(m2s(pos + Vector3.new(0, s * 0.35, 0))) * CFrame.Angles(rnd:NextNumber(), rnd:NextNumber() * 6, rnd:NextNumber() * 0.5),
			Color = color,
			Material = Enum.Material.Slate,
			CastShadow = true,
		},
		parent
	)
end

local function decorate(track, trackId: string, parent: Instance, groundY: number)
	local env = ENV[trackId] or ENV.sakura
	local rnd = Random.new(#trackId * 977 + math.floor(track.length))
	local mn, mx = track.boundsMin, track.boundsMax
	local placed = 0
	local tries = 0
	while placed < 170 and tries < 3000 do
		tries += 1
		local x = mn.X - 90 + rnd:NextNumber() * (mx.X - mn.X + 180)
		local z = mn.Z - 90 + rnd:NextNumber() * (mx.Z - mn.Z + 180)
		local dist, idx = track:distanceTo(x, z, 120)
		if idx >= 0 then
			local i = idx + 1
			local lim = track.hw[i] + track.wall[i]
			if dist > lim + 4 then
				local y
				if dist < lim + 15 then
					y = track.pos[i].Y - 0.3 -- на насыпи у дороги
				elseif dist > lim + 26 then
					y = groundY
				end
				if y and not (track.flags[i] == 1 and dist < lim + 26) then
					local p = Vector3.new(x, y, z)
					local kind = env.decor
					if kind == "sakura" then
						if rnd:NextNumber() < 0.85 then
							tree(
								parent,
								p,
								1 + rnd:NextNumber() * 0.4,
								Color3.fromRGB(110, 70, 60),
								{ Color3.fromRGB(255, 170, 205), Color3.fromRGB(255, 196, 222), Color3.fromRGB(255, 140, 186) },
								rnd
							)
						else
							rock(parent, p, rnd, Color3.fromRGB(170, 170, 180))
						end
					elseif kind == "neon" then
						if dist > lim + 18 then
							building(parent, p, rnd)
						end
					elseif kind == "sunset" then
						if rnd:NextNumber() < 0.7 then
							palm(parent, p, rnd)
						else
							rock(parent, p, rnd, Color3.fromRGB(200, 150, 110))
						end
					else
						tree(
							parent,
							p,
							1 + rnd:NextNumber() * 0.5,
							Color3.fromRGB(100, 70, 50),
							{ Color3.fromRGB(230, 80, 40), Color3.fromRGB(255, 140, 40), Color3.fromRGB(200, 50, 40), Color3.fromRGB(250, 190, 60) },
							rnd
						)
					end
					placed += 1
				end
			end
		end
	end
end

-- ---------------------------------------------------------------- постройка

export type Built = {
	trackId: string,
	track: any,
	folder: Folder,
	lights: { Part },
	boxes: { any },
	coins: { any },
	traps: { [number]: any },
	time: number,
}

local current: Built? = nil

function World.current(): Built?
	return current
end

function World.build(trackId: string): Built
	if current and current.trackId == trackId then
		return current
	end
	if root then
		root:Destroy()
	end
	workspace.Terrain:Clear()
	local track = Tracks.get(trackId)
	local data = track.data
	local theme = data.theme
	local env = ENV[trackId] or ENV.sakura
	applyLighting(trackId)

	local folder = Instance.new("Folder")
	folder.Name = "SakuraWorld"
	root = folder
	local roadF = Instance.new("Folder")
	roadF.Name = "Road"
	roadF.Parent = folder
	local decoF = Instance.new("Folder")
	decoF.Name = "Decor"
	decoF.Parent = folder

	local N = track.count
	local mn, mx = track.boundsMin, track.boundsMax
	local groundY = mn.Y - 0.6

	-- земля (Terrain) и насыпь под дорогой
	local T = workspace.Terrain
	T:SetMaterialColor(env.ground, env.groundColor)
	local cx, cz = (mn.X + mx.X) / 2, (mn.Z + mx.Z) / 2
	local sx, sz = (mx.X - mn.X) + 500, (mx.Z - mn.Z) + 500
	-- заливаем кусками: у операций с Terrain есть предел объёма за один вызов
	local TILE = 300 -- м
	local nx, nz = math.ceil(sx / TILE), math.ceil(sz / TILE)
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local x0 = cx - sx / 2 + (ix + 0.5) * TILE
			local z0 = cz - sz / 2 + (iz + 0.5) * TILE
			T:FillBlock(CFrame.new(x0 * SC, (groundY - 4) * SC, z0 * SC), Vector3.new(TILE * SC, 8 * SC, TILE * SC), env.ground)
		end
	end
	if trackId == "sunset" then
		-- море за пляжем
		T:FillBlock(CFrame.new(cx * SC, (groundY - 0.6) * SC, (mn.Z - 220) * SC), Vector3.new(sx * SC, 1.2 * SC, 300 * SC), Enum.Material.Water)
	end
	local STEP = 2
	for i = 0, N - 1, STEP do
		local ia = i + 1
		local ib = ((i + STEP) % N) + 1
		local a, b = track.pos[ia], track.pos[ib]
		local hgt = math.min(a.Y, b.Y) - groundY
		local lim = track.hw[ia] + track.wall[ia]
		if track.flags[ia] ~= 1 and hgt > 0.4 then
			local mid = (a + b) / 2
			local tan = (b - a)
			tan = Vector3.new(tan.X, 0, tan.Z)
			if tan.Magnitude > 1e-3 then
				local w = 2 * (lim + 16)
				local top = math.min(a.Y, b.Y) - 0.35
				local h = top - groundY + 1
				local cf = CFrame.lookAt(Vector3.new(mid.X, top - h / 2, mid.Z) * SC, (Vector3.new(mid.X, top - h / 2, mid.Z) + tan) * SC)
				T:FillBlock(cf, Vector3.new(w * SC, h * SC, (tan.Magnitude + 3) * SC), env.ground)
			end
		elseif track.flags[ia] == 1 and i % 10 == 0 and hgt > 1.5 then
			-- опоры моста
			for _, side in { -1, 1 } do
				local p = a + track.right[ia] * (side * (track.hw[ia] * 0.7))
				local h = p.Y - groundY
				part(
					{
						Size = Vector3.new(1.4 * SC, h * SC, 1.4 * SC),
						CFrame = CFrame.new(Vector3.new(p.X, groundY + h / 2 - 0.4, p.Z) * SC),
						Color = Color3.fromRGB(190, 190, 205),
						Material = Enum.Material.Concrete,
						CastShadow = true,
					},
					roadF
				)
			end
		end
	end

	-- дорога: асфальт, белые кромки, бордюры, обочины, стены
	local roadC = hex(theme.road)
	local edgeC = hex(theme.edge)
	local centerC = hex(theme.center)
	local curbA, curbB = hex(theme.curbA), hex(theme.curbB)
	local wallA, wallB = hex(theme.wallA), hex(theme.wallB)
	local wallMat = if theme.wallStyle == "neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local shoulderC = env.shoulder
	local CURB = 1.5
	local seg = 0
	for i = 0, N - 1, STEP do
		seg += 1
		local j = i + STEP
		local ia = i + 1
		local hw = track.hw[ia]
		local wall = track.wall[ia]
		strip(track, i, j, -hw + 0.35, hw - 0.35, 0.02, 0.5, roadC, roadF, Enum.Material.Asphalt)
		strip(track, i, j, -hw, -hw + 0.35, 0.03, 0.5, edgeC, roadF)
		strip(track, i, j, hw - 0.35, hw, 0.03, 0.5, edgeC, roadF)
		if seg % 3 == 0 then
			strip(track, i, j, -0.18, 0.18, 0.04, 0.2, centerC, roadF)
		end
		local cc = if seg % 2 == 0 then curbA else curbB
		strip(track, i, j, -hw - CURB, -hw, 0.06, 0.5, cc, roadF)
		strip(track, i, j, hw, hw + CURB, 0.06, 0.5, cc, roadF)
		if wall > CURB + 0.05 then
			strip(track, i, j, -hw - wall, -hw - CURB, 0.0, 0.5, shoulderC, roadF, Enum.Material.Grass)
			strip(track, i, j, hw + CURB, hw + wall, 0.0, 0.5, shoulderC, roadF, Enum.Material.Grass)
		end
		local wc = if (seg // 2) % 2 == 0 then wallA else wallB
		local wh = if theme.wallStyle == "neon" then 0.9 else 1.1
		strip(track, i, j, -hw - wall - 0.6, -hw - wall, wh, wh + 0.5, wc, roadF, wallMat)
		strip(track, i, j, hw + wall, hw + wall + 0.6, wh, wh + 0.5, wc, roadF, wallMat)
		if track.flags[ia] == 1 then
			-- низ моста
			strip(track, i, j, -hw - wall - 0.6, hw + wall + 0.6, -0.5, 0.8, Color3.fromRGB(170, 170, 185), roadF, Enum.Material.Concrete)
		end
	end

	-- бустеры
	local boostC = hex(theme.boost)
	for _, z in track.boostZones do
		local len = z.s1 - z.s0
		local fr = track:frameAtProgress(z.s0 + len / 2)
		local c = fr.pos + fr.right * z.lat + fr.up * 0.07
		local back = fr.right:Cross(fr.up)
		local cf = CFrame.fromMatrix(c * SC, fr.right, fr.up, back)
		part(
			{ Size = Vector3.new(z.halfW * 2 * SC, 0.12 * SC, len * SC), CFrame = cf, Color = boostC, Material = Enum.Material.Neon, Transparency = 0.15 },
			roadF
		)
		for k = -1, 1 do
			part(
				{
					Size = Vector3.new(z.halfW * 1.2 * SC, 0.14 * SC, 0.5 * SC),
					CFrame = cf * CFrame.new(0, 0.02 * SC, k * len / 3.5 * SC) * CFrame.Angles(0, 0, 0),
					Color = Color3.new(1, 1, 1),
					Material = Enum.Material.Neon,
				},
				roadF
			)
		end
	end

	-- трамплины: несколько наклонных плит по профилю высоты
	local gateC = hex(theme.gateA)
	for _, z in track.rampZones do
		local n = 6
		for k = 0, n - 1 do
			local u0, u1 = k / n, (k + 1) / n
			local s0, s1 = z.s0 + z.len * u0, z.s0 + z.len * u1
			local h0 = (track.rampHeightAt :: any)(z, u0)
			local h1 = (track.rampHeightAt :: any)(z, u1)
			local p0 = track:pointAt(s0, z.lat, h0)
			local p1 = track:pointAt(s1, z.lat, h1)
			local fr = track:frameAtProgress((s0 + s1) / 2)
			local d = p1 - p0
			local fwd = d.Unit
			local up = fr.right:Cross(fwd).Unit
			if up.Y < 0 then
				up = -up
			end
			local right = fwd:Cross(up).Unit
			local back = right:Cross(up)
			local th = 0.3
			local mid = (p0 + p1) / 2 - up * (th / 2)
			part(
				{
					Size = Vector3.new(z.halfW * 2 * SC, th * SC, (d.Magnitude + 0.1) * SC),
					CFrame = CFrame.fromMatrix(mid * SC, right, up, back),
					Color = if k % 2 == 0 then gateC else Color3.fromRGB(255, 230, 90),
					Material = Enum.Material.SmoothPlastic,
				},
				roadF
			)
			-- боковины до дороги
			local hm = (h0 + h1) / 2
			if hm > 0.15 then
				for _, side in { -1, 1 } do
					local base = track:pointAt((s0 + s1) / 2, z.lat + side * z.halfW, hm / 2)
					part(
						{
							Size = Vector3.new(0.25 * SC, hm * SC, (d.Magnitude + 0.1) * SC),
							CFrame = CFrame.fromMatrix(base * SC, fr.right, fr.up, fr.right:Cross(fr.up)),
							Color = Color3.fromRGB(60, 60, 80),
						},
						roadF
					)
				end
			end
		end
	end

	-- старт/финиш: шахматка и арка с табло и светофором
	local lights: { Part } = {}
	do
		local fr = track:frameAtProgress(0)
		local hw = fr.hw
		local cells = math.floor(hw * 2 / 1)
		local back = fr.right:Cross(fr.up)
		for row = 0, 1 do
			for k = 0, cells - 1 do
				local lat = -hw + (k + 0.5) * (hw * 2 / cells)
				local c = fr.pos + fr.right * lat + fr.up * 0.06 + fr.tan * ((row - 0.5) * 1)
				part(
					{
						Size = Vector3.new(hw * 2 / cells * SC, 0.1 * SC, 1 * SC),
						CFrame = CFrame.fromMatrix(c * SC, fr.right, fr.up, back),
						Color = if (k + row) % 2 == 0 then Color3.new(1, 1, 1) else Color3.fromRGB(20, 20, 30),
					},
					roadF
				)
			end
		end
		local gf = track:frameAtProgress(4)
		local gb = gf.right:Cross(gf.up)
		local H = 7
		local span = gf.hw + 2.2
		for _, side in { -1, 1 } do
			local p = gf.pos + gf.right * (side * span) + gf.up * (H / 2)
			part(
				{
					Size = Vector3.new(1.2 * SC, H * SC, 1.2 * SC),
					CFrame = CFrame.fromMatrix(p * SC, gf.right, gf.up, gb),
					Color = gateC,
					Material = Enum.Material.SmoothPlastic,
					CastShadow = true,
				},
				roadF
			)
		end
		local barC = gf.pos + gf.up * (H + 0.6)
		local bar = part(
			{
				Size = Vector3.new((span * 2 + 1.2) * SC, 1.8 * SC, 0.8 * SC),
				CFrame = CFrame.fromMatrix(barC * SC, gf.right, gf.up, gb),
				Color = Color3.fromRGB(30, 26, 50),
				CastShadow = true,
			},
			roadF
		)
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local sg = Instance.new("SurfaceGui")
			sg.Face = face
			sg.PixelsPerStud = 20
			sg.LightInfluence = 0
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			local tl = Instance.new("TextLabel")
			tl.Size = UDim2.fromScale(1, 1)
			tl.BackgroundTransparency = 1
			tl.Text = theme.gateText
			tl.TextScaled = true
			tl.Font = Enum.Font.FredokaOne
			tl.TextColor3 = Color3.new(1, 1, 1)
			tl.TextStrokeColor3 = gateC
			tl.TextStrokeTransparency = 0
			tl.Parent = sg
			sg.Parent = bar
		end
		for k = 1, 4 do
			local off = (k - 2.5) * 2.2
			local p = barC + gf.up * 1.6 + gf.right * off
			table.insert(
				lights,
				part(
					{
						Shape = Enum.PartType.Ball,
						Size = Vector3.one * 1.3 * SC,
						CFrame = CFrame.new(p * SC),
						Color = Color3.fromRGB(60, 40, 40),
						Material = Enum.Material.SmoothPlastic,
					},
					roadF
				)
			)
		end
	end

	-- декор
	decorate(track, trackId, decoF, groundY)

	-- кристаллы
	local itemF = Instance.new("Folder")
	itemF.Name = "Items"
	itemF.Parent = folder
	local boxes = {}
	for i, b in Layout.boxes(track) do
		local p = part(
			{
				Size = Vector3.one * 1.35 * SC,
				CFrame = CFrame.new(b.pos * SC),
				Color = Color3.fromHSV((i * 0.17) % 1, 0.6, 1),
				Material = Enum.Material.Neon,
				Transparency = 0.35,
			},
			itemF
		)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromScale(2.4, 2.4)
		bb.LightInfluence = 0
		bb.MaxDistance = 400
		local q = Instance.new("TextLabel")
		q.Size = UDim2.fromScale(1, 1)
		q.BackgroundTransparency = 1
		q.Text = "?"
		q.TextScaled = true
		q.Font = Enum.Font.FredokaOne
		q.TextColor3 = Color3.new(1, 1, 1)
		q.TextStrokeColor3 = Color3.fromRGB(80, 20, 120)
		q.TextStrokeTransparency = 0
		q.Parent = bb
		bb.Parent = p
		table.insert(boxes, { s = b.s, lat = b.lat, pos = b.pos, part = p, gui = bb, active = true, timer = 0, scale = 1, phase = i })
	end
	-- монеты
	local coins = {}
	for i, c in Layout.coins(track) do
		local p = part(
			{
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.14 * SC, 1.24 * SC, 1.24 * SC),
				CFrame = CFrame.new(c.pos * SC),
				Color = Color3.fromRGB(255, 194, 26),
				Material = Enum.Material.Neon,
			},
			itemF
		)
		table.insert(coins, { s = c.s, lat = c.lat, pos = c.pos, part = p, t = 0, phase = (i - 1) % 5 * 0.5 })
	end

	folder.Parent = workspace
	local built: Built = {
		trackId = trackId,
		track = track,
		folder = folder,
		lights = lights,
		boxes = boxes,
		coins = coins,
		traps = {},
		time = 0,
	}
	current = built
	return built
end

--- Светофор: 0 — выкл, 1..3 — красные по очереди, 4 — все зелёные.
function World.setLights(stage: number)
	local w = current
	if not w then
		return
	end
	for k, l in w.lights do
		if stage >= 4 then
			l.Color = Color3.fromRGB(60, 255, 120)
			l.Material = Enum.Material.Neon
		elseif k <= stage then
			l.Color = Color3.fromRGB(255, 50, 60)
			l.Material = Enum.Material.Neon
		else
			l.Color = Color3.fromRGB(60, 40, 40)
			l.Material = Enum.Material.SmoothPlastic
		end
	end
end

function World.setBoxTaken(i: number, timer: number?)
	local w = current
	if not w then
		return
	end
	local b = w.boxes[i]
	if b then
		b.active = false
		b.timer = timer or Layout.BOX_RESPAWN
	end
end

function World.setCoinTaken(i: number, timer: number?)
	local w = current
	if not w then
		return
	end
	local c = w.coins[i]
	if c then
		c.t = timer or Layout.COIN_RESPAWN
	end
end

function World.addTrap(id: number, x: number, y: number, z: number, s: number, lat: number)
	local w = current
	if not w then
		return
	end
	local m = Instance.new("Model")
	m.Name = "IceTrap"
	local base = Vector3.new(x, y, z)
	local col = Color3.fromRGB(174, 239, 255)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local off = Vector3.new(math.cos(a) * 0.5, 0, math.sin(a) * 0.5)
		local h = 0.9 + (k % 2) * 0.5
		part(
			{
				Size = Vector3.new(0.45, h, 0.45) * SC,
				CFrame = CFrame.new((base + off + Vector3.new(0, h / 2, 0)) * SC) * CFrame.Angles(math.cos(a) * 0.4, 0, math.sin(a) * 0.4),
				Color = col,
				Material = Enum.Material.Ice,
				Transparency = 0.15,
			},
			m
		)
	end
	part(
		{
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.1 * SC,
			CFrame = CFrame.new((base + Vector3.new(0, 0.5, 0)) * SC),
			Color = Color3.fromRGB(90, 190, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.4,
		},
		m
	)
	m.Parent = w.folder
	w.traps[id] = { id = id, pos = base, s = s, lat = lat, model = m, age = 0 }
end

function World.removeTrap(id: number)
	local w = current
	if not w then
		return
	end
	local t = w.traps[id]
	if t then
		t.model:Destroy()
		w.traps[id] = nil
	end
end

function World.clearTraps()
	local w = current
	if not w then
		return
	end
	for id in w.traps do
		World.removeTrap(id)
	end
end

--- Анимация кристаллов и монет, таймеры их возвращения.
function World.update(dt: number)
	local w = current
	if not w then
		return
	end
	w.time += dt
	local t = w.time
	local parts, cfs = {}, {}
	for i, b in w.boxes do
		if not b.active then
			b.timer -= dt
			if b.timer <= 0 then
				b.active = true
				b.scale = 0.05
			end
		else
			b.scale = math.min(1, b.scale + dt * 3)
		end
		local hidden = not b.active
		b.part.Transparency = if hidden then 1 else 0.35
		b.gui.Enabled = not hidden
		local bob = math.sin(t * 2.4 + i) * 0.15
		b.part.Size = Vector3.one * 1.35 * SC * math.max(0.05, b.scale)
		b.part.Color = Color3.fromHSV((t * 0.25 + i * 0.17) % 1, 0.55, 1)
		table.insert(parts, b.part)
		table.insert(cfs, CFrame.new((b.pos + Vector3.new(0, bob, 0)) * SC) * CFrame.Angles(t * 0.9 + i, t * 1.3 + i * 0.7, 0.4))
	end
	for _, c in w.coins do
		if c.t > 0 then
			c.t -= dt
			c.part.Transparency = 1
		else
			c.part.Transparency = 0
		end
		table.insert(parts, c.part)
		table.insert(cfs, CFrame.new(c.pos * SC) * CFrame.Angles(0, t * 3.2 + c.phase, 0) * CFrame.Angles(0, math.pi / 2, 0))
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	for _, tr in w.traps do
		tr.age += dt
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>